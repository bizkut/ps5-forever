+#[derive(Deserialize)]
+struct HeadlessRequest {
+    command: String,
+    #[serde(default)]
+    args: Value,
+}
+
+fn string_arg(args: &Value, name: &str) -> Result<String, String> {
+    args.get(name)
+        .and_then(Value::as_str)
+        .map(str::to_owned)
+        .ok_or_else(|| format!("missing string argument: {name}"))
+}
+
+async fn update_all_impl(app: Shared) -> Result<Vec<Package>, String> {
+    let packages = check_updates_impl(app.clone()).await?;
+    let keys: Vec<String> = packages
+        .iter()
+        .filter(|package| package.update_available && !package.pinned)
+        .map(|package| package.key.clone())
+        .collect();
+    let mut updated = Vec::with_capacity(keys.len());
+    for key in keys {
+        updated.push(update_package_impl(&app, key, Some(false)).await?);
+    }
+    Ok(updated)
+}
+
+async fn install_bundle_impl(app: &App, id: String) -> Result<Vec<Package>, String> {
+    let catalog = catalog_cached(app).await;
+    let bundle = catalog
+        .bundles
+        .iter()
+        .find(|bundle| bundle.id == id)
+        .ok_or_else(|| "Starter pack not found".to_string())?;
+    let ids = bundle.addons.clone();
+    let mut installed = Vec::with_capacity(ids.len());
+    for addon_id in ids {
+        let entry = catalog
+            .addons
+            .iter()
+            .find(|entry| entry.id == addon_id)
+            .ok_or_else(|| format!("Starter pack entry not found: {addon_id}"))?;
+        if entry.github.is_none()
+            && entry.wowi.is_none()
+            && entry.tukui.is_none()
+            && entry.wago.is_none()
+        {
+            continue;
+        }
+        installed.push(install_catalog_impl(app, addon_id, Some(false)).await?);
+    }
+    Ok(installed)
+}
+
+async fn dispatch_headless(app: Shared, request: HeadlessRequest) -> Result<Value, String> {
+    let _operation = app.mutation.lock().await;
+    if app.shutting_down.load(Ordering::Acquire) {
+        return Err("add-on service is shutting down".into());
+    }
+    if request.command == "shutdown" {
+        app.shutting_down.store(true, Ordering::Release);
+    }
+    let args = &request.args;
+    match request.command.as_str() {
+        "find_installs" => serde_json::to_value(find_installs_impl(&app).await?).map_err(err),
+        "set_install_path" => {
+            let path = string_arg(args, "path")?;
+            serde_json::to_value(set_install_path_impl(&app, path).await?).map_err(err)
+        }
+        "scan" => serde_json::to_value(scan_packages(&app).await?).map_err(err),
+        "check_updates" => serde_json::to_value(check_updates_impl(app.clone()).await?).map_err(err),
+        "update_all" => serde_json::to_value(update_all_impl(app.clone()).await?).map_err(err),
+        "catalog_list" => {
+            let refresh = args.get("refresh").and_then(Value::as_bool);
+            serde_json::to_value(catalog_list_impl(&app, refresh).await?).map_err(err)
+        }
+        "bundles" => serde_json::to_value(bundles_impl(&app).await?).map_err(err),
+        "install_catalog" => {
+            let id = string_arg(args, "id")?;
+            let allow = args.get("allow_non_forever").and_then(Value::as_bool);
+            serde_json::to_value(install_catalog_impl(&app, id, allow).await?).map_err(err)
+        }
+        "install_bundle" => {
+            let id = string_arg(args, "id")?;
+            serde_json::to_value(install_bundle_impl(&app, id).await?).map_err(err)
+        }
+        "remove_package" => {
+            let key = string_arg(args, "key")?;
+            serde_json::to_value(remove_package_impl(&app, key).await?).map_err(err)
+        }
+        "update_package" => {
+            let key = string_arg(args, "key")?;
+            let allow = args.get("allow_non_forever").and_then(Value::as_bool);
+            serde_json::to_value(update_package_impl(&app, key, allow).await?).map_err(err)
+        }
+        "shutdown" => Ok(Value::Null),
+        _ => Err(format!("unknown command: {}", request.command)),
+    }
+}
+
+fn header_end(bytes: &[u8]) -> Option<usize> {
+    bytes
+        .windows(4)
+        .position(|window| window == b"\r\n\r\n")
+        .map(|offset| offset + 4)
+}
+
+const MAX_HEADLESS_REQUEST: usize = 1024 * 1024;
+
+fn checked_request_total(header_bytes: usize, content_bytes: usize) -> Result<usize, String> {
+    if header_bytes > MAX_HEADLESS_REQUEST ||
+        content_bytes > MAX_HEADLESS_REQUEST - header_bytes {
+        return Err("HTTP request is too large".into());
+    }
+    Ok(header_bytes + content_bytes)
+}
+
+fn authorized(headers: &str, token: &str) -> bool {
+    headers.lines().filter_map(|line| line.split_once(':')).any(|(name, value)| {
+        name.eq_ignore_ascii_case("authorization")
+            && value.trim().strip_prefix("Bearer ") == Some(token)
+    })
+}
+
+fn finish_headless_response(
+    app: &App, notify_shutdown: bool, result: Result<(), String>
+) -> Result<(), String> {
+    if notify_shutdown {
+        app.shutdown.notify_one();
+    }
+    result
+}
+
+async fn handle_http_connection(
+    mut stream: tokio::net::TcpStream,
+    app: Shared,
+    token: Arc<String>,
+) -> Result<(), String> {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    let mut bytes = Vec::with_capacity(4096);
+    let (head_end, total) = loop {
+        if bytes.len() > MAX_HEADLESS_REQUEST {
+            return Err("HTTP request is too large".into());
+        }
+        if let Some(end) = header_end(&bytes) {
+            let head = std::str::from_utf8(&bytes[..end]).map_err(err)?;
+            let length = head
+                .lines()
+                .filter_map(|line| line.split_once(':'))
+                .find(|(name, _)| name.eq_ignore_ascii_case("content-length"))
+                .map(|(_, value)| value.trim().parse::<usize>().map_err(err))
+                .transpose()?
+                .unwrap_or(0);
+            break (end, checked_request_total(end, length)?);
+        }
+        let read = stream.read_buf(&mut bytes).await.map_err(err)?;
+        if read == 0 {
+            return Err("HTTP connection closed before headers".into());
+        }
+    };
+    while bytes.len() < total {
+        if stream.read_buf(&mut bytes).await.map_err(err)? == 0 {
+            return Err("HTTP connection closed before body".into());
+        }
+        if bytes.len() > MAX_HEADLESS_REQUEST {
+            return Err("HTTP request is too large".into());
+        }
+    }
+
+    let head = std::str::from_utf8(&bytes[..head_end]).map_err(err)?;
+    let mut request_line = head
+        .lines()
+        .next()
+        .unwrap_or_default()
+        .split_ascii_whitespace();
+    let method = request_line.next().unwrap_or_default();
+    let path = request_line
+        .next()
+        .unwrap_or_default()
+        .split('?')
+        .next()
+        .unwrap_or_default();
+    let body = &bytes[head_end..total];
+    let mut notify_shutdown = false;
+
+    let (status, response) = if !authorized(head, &token) {
+        (
+            "401 Unauthorized",
+            serde_json::json!({"ok": false, "error": "unauthorized"}),
+        )
+    } else if method == "GET" && path == "/health" {
+        (
+            "200 OK",
+            serde_json::json!({"ok": true, "result": {"status": "ready"}}),
+        )
+    } else if method == "POST" {
+        let parsed = if path == "/" || path == "/command" {
+            serde_json::from_slice::<HeadlessRequest>(body).map_err(err)
+        } else {
+            let command = path.trim_matches('/').to_string();
+            let args = if body.is_empty() {
+                Value::Object(serde_json::Map::new())
+            } else {
+                serde_json::from_slice(body).map_err(err)?
+            };
+            Ok(HeadlessRequest { command, args })
+        };
+        match parsed {
+            Ok(request) => {
+                let requested_shutdown = request.command == "shutdown";
+                match dispatch_headless(app.clone(), request).await {
+                    Ok(result) => {
+                        notify_shutdown = requested_shutdown;
+                        ("200 OK", serde_json::json!({"ok": true, "result": result}))
+                    }
+                    Err(error) => ("200 OK", serde_json::json!({"ok": false, "error": error})),
+                }
+            }
+            Err(error) => (
+                "400 Bad Request",
+                serde_json::json!({"ok": false, "error": error}),
+            ),
+        }
+    } else {
+        (
+            "405 Method Not Allowed",
+            serde_json::json!({"ok": false, "error": "use POST, or GET /health"}),
+        )
+    };
+    let response_result: Result<(), String> = async {
+        let payload = serde_json::to_vec(&response).map_err(err)?;
+        let header = format!(
+            "HTTP/1.1 {status}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+            payload.len()
+        );
+        stream.write_all(header.as_bytes()).await.map_err(err)?;
+        stream.write_all(&payload).await.map_err(err)?;
+        stream.shutdown().await.map_err(err)
+    }
+    .await;
+    finish_headless_response(&app, notify_shutdown, response_result)
+}
+
+async fn serve_headless(port: u16, token: String) -> Result<(), String> {
+    if token.len() < 32
+        || token.len() > 128
+        || !token.bytes().all(|byte| byte.is_ascii_hexdigit())
+    {
+        return Err("token must be 32 to 128 hexadecimal characters".into());
+    }
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", port))
+        .await
+        .map_err(err)?;
+    let app = make_app();
+    let token = Arc::new(token);
+    println!("addonforge-core: serving http://127.0.0.1:{port}");
+    loop {
+        tokio::select! {
+            accepted = listener.accept() => {
+                let (stream, _) = accepted.map_err(err)?;
+                let app = app.clone();
+                let token = token.clone();
+                tokio::spawn(async move {
+                    if let Err(error) = handle_http_connection(stream, app, token).await {
+                        loge!("HTTP request: {error}");
+                    }
+                });
+            }
+            _ = app.shutdown.notified() => break,
+        }
+    }
+    Ok(())
+}
+
+fn selftest_line(message: impl std::fmt::Display) {
+    use std::io::Write;
+
+    let mut stdout = std::io::stdout().lock();
+    let _ = writeln!(stdout, "addonforge-selftest: {message}");
+    let _ = stdout.flush();
+}
+
+async fn selftest_inner(app: Shared, product_dir: String) -> Result<(), String> {
+    const TEST_ID: &str = "target-percent";
+    let started = std::time::Instant::now();
+    let found = find_installs_impl(&app).await?;
+    let discovery_ms = started.elapsed().as_millis();
+    let target_found = found
+        .iter()
+        .any(|install| install.path.eq_ignore_ascii_case(&product_dir));
+    selftest_line(format!(
+        "find installs count={} target_found={} ms={discovery_ms}",
+        found.len(),
+        target_found as u8
+    ));
+
+    let selected = set_install_path_impl(&app, product_dir.clone()).await?;
+    if selected.flavor != "forever" {
+        return Err(format!(
+            "selected product is not Forever: {}",
+            selected.product
+        ));
+    }
+    selftest_line(format!(
+        "select product={} flavor={} path={}",
+        selected.product, selected.flavor, selected.path
+    ));
+
+    let started = std::time::Instant::now();
+    let packages = scan_packages(&app).await?;
+    selftest_line(format!(
+        "scan count={} ms={}",
+        packages.len(),
+        started.elapsed().as_millis()
+    ));
+
+    let started = std::time::Instant::now();
+    let rows = catalog_list_impl(&app, Some(true)).await?;
+    let source = app
+        .catalog
+        .lock()
+        .await
+        .as_ref()
+        .map(|entry| entry.1)
+        .unwrap_or("unknown");
+    selftest_line(format!(
+        "catalog fetch count={} source={} network_tls_ms={}",
+        rows.len(),
+        source,
+        started.elapsed().as_millis()
+    ));
+    if !rows
+        .iter()
+        .any(|row| row.entry.id == TEST_ID && row.entry.github.is_some())
+    {
+        return Err(format!(
+            "small GitHub catalogue addon {TEST_ID} is unavailable"
+        ));
+    }
+    let bundles = bundles_impl(&app).await?;
+    selftest_line(format!("bundles count={}", bundles.len()));
+
+    let install_started = std::time::Instant::now();
+    let installed = install_catalog_impl(&app, TEST_ID.into(), Some(false)).await?;
+    let timing = app
+        .last_install_timing
+        .lock()
+        .await
+        .clone()
+        .unwrap_or_default();
+    selftest_line(format!(
+        "install id={} folders={} total_ms={} resolve_tls_ms={} download_ms={} zip_ms={} broker_write_ms={}",
+        TEST_ID,
+        installed.folders.len(),
+        install_started.elapsed().as_millis(),
+        timing.resolve_tls_ms,
+        timing.download_ms,
+        timing.zip_ms,
+        timing.broker_write_ms
+    ));
+
+    let addons = addons_dir(&product_dir);
+    let present = installed
+        .folders
+        .iter()
+        .all(|folder| addons.join(folder).is_dir());
+    selftest_line(format!(
+        "verify installed folders={} ok={}",
+        installed.folders.len(),
+        present as u8
+    ));
+    if !present {
+        return Err("one or more installed addon folders are missing".into());
+    }
+
+    let started = std::time::Instant::now();
+    let checked = check_updates_impl(app.clone()).await?;
+    let updates = checked
+        .iter()
+        .filter(|package| package.update_available)
+        .count();
+    selftest_line(format!(
+        "check updates packages={} updates={} network_tls_ms={}",
+        checked.len(),
+        updates,
+        started.elapsed().as_millis()
+    ));
+
+    let started = std::time::Instant::now();
+    let removed = remove_package_impl(&app, format!("cat:{TEST_ID}")).await?;
+    selftest_line(format!(
+        "remove folders={} broker_write_ms={}",
+        removed.len(),
+        started.elapsed().as_millis()
+    ));
+    let gone = installed
+        .folders
+        .iter()
+        .all(|folder| !addons.join(folder).exists());
+    selftest_line(format!(
+        "verify removed folders={} ok={}",
+        installed.folders.len(),
+        gone as u8
+    ));
+    if !gone {
+        return Err("one or more removed addon folders still exist".into());
+    }
+    Ok(())
+}
+
+async fn selftest(product_dir: String) -> Result<(), String> {
+    const TEST_KEY: &str = "cat:target-percent";
+    let app = make_app();
+    selftest_line(format!("start product={product_dir}"));
+    let result = selftest_inner(app.clone(), product_dir).await;
+    if result.is_err() && app.state.lock().await.installed.contains_key(TEST_KEY) {
+        match remove_package_impl(&app, TEST_KEY.into()).await {
+            Ok(removed) => selftest_line(format!("cleanup removed folders={}", removed.len())),
+            Err(error) => selftest_line(format!("cleanup failed error={error}")),
+        }
+    }
+    result
+}
