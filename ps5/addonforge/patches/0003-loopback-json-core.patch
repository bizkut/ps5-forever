+/// Entry point for the Tauri-free core binary. Self-update is intentionally absent.
+pub fn headless_main(args: &[String]) -> i32 {
+    let runtime = tokio::runtime::Runtime::new().expect("tokio runtime");
+    let result = match args.first().map(String::as_str) {
+        Some("serve") => {
+            let port = args
+                .windows(2)
+                .find(|pair| pair[0] == "--port")
+                .and_then(|pair| pair[1].parse::<u16>().ok())
+                .ok_or_else(|| {
+                    "usage: addonforge-core serve --port N --token HEX".to_string()
+                });
+            let token = args
+                .windows(2)
+                .find(|pair| pair[0] == "--token")
+                .map(|pair| pair[1].clone())
+                .ok_or_else(|| {
+                    "usage: addonforge-core serve --port N --token HEX".to_string()
+                });
+            match (port, token) {
+                (Ok(port), Ok(token)) => runtime.block_on(serve_headless(port, token)),
+                (Err(error), _) | (_, Err(error)) => Err(error),
+            }
+        }
+        Some("selftest") => match args.get(1) {
+            Some(product_dir) => runtime.block_on(selftest(product_dir.clone())),
+            None => Err("usage: addonforge-core selftest <product dir>".into()),
+        },
+        _ => Err(
+            "usage: addonforge-core serve --port N --token HEX | selftest <product dir>".into(),
+        ),
+    };
+    match result {
+        Ok(()) => {
+            if args.first().map(String::as_str) == Some("selftest") {
+                selftest_line("done ok=1");
+            }
+            0
+        }
+        Err(error) => {
+            if args.first().map(String::as_str) == Some("selftest") {
+                selftest_line(format!("error {error}"));
+                selftest_line("done ok=0");
+            } else {
+                eprintln!("addonforge-core: {error}");
+            }
+            1
+        }
+    }
+}
