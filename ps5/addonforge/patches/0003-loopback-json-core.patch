+    fn headless_content_length_never_wraps_or_exceeds_limit() {
+        assert_eq!(checked_request_total(128, 256).unwrap(), 384);
+        assert_eq!(
+            checked_request_total(128, MAX_HEADLESS_REQUEST - 128).unwrap(),
+            MAX_HEADLESS_REQUEST
+        );
+        assert!(checked_request_total(128, MAX_HEADLESS_REQUEST - 127).is_err());
+        assert!(checked_request_total(128, usize::MAX).is_err());
+        assert!(checked_request_total(usize::MAX, 0).is_err());
