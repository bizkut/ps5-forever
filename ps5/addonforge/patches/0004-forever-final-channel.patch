+    #[test]
+    fn classic_beta_and_final_forever_products_are_discovered() {
+        let root = std::env::temp_dir().join(format!("af-installs-{}", std::process::id()));
+        let world = root.join("World of Warcraft");
+        let beta = world.join("_classic_beta_");
+        let final_product = world.join("_forever_");
+        for (dir, product) in [(&beta, "wow_classic_beta"), (&final_product, "wowf")] {
+            std::fs::create_dir_all(dir.join("Interface").join("AddOns")).unwrap();
+            std::fs::write(
+                dir.join(".flavor.info"),
+                format!("Product Flavor!STRING:0\n{product}\n"),
+            )
+            .unwrap();
+        }
+
+        let found = find_installs_in_roots(&[world]);
+        assert_eq!(found.len(), 2);
+        assert!(found.iter().all(|install| install.flavor == "forever"));
+        assert_eq!(
+            found
+                .iter()
+                .find(|install| install.product == "wowf")
+                .map(|install| install.label.as_str()),
+            Some("WoW: Forever")
+        );
+        let _ = std::fs::remove_dir_all(root);
+    }
