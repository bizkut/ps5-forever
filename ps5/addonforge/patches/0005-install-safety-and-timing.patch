+fn link_or_reparse(metadata: &fs::Metadata) -> bool {
+    if metadata.file_type().is_symlink() {
+        return true;
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::MetadataExt;
+        return metadata.file_attributes() & 0x400 != 0; // FILE_ATTRIBUTE_REPARSE_POINT
+    }
+    #[cfg(not(windows))]
+    false
+}
+
+fn unlink_link_or_reparse(path: &Path, _metadata: &fs::Metadata) -> std::io::Result<()> {
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::FileTypeExt;
+        if _metadata.is_dir() || _metadata.file_type().is_symlink_dir() {
+            return fs::remove_dir(path);
+        }
+    }
+    fs::remove_file(path)
+}
+
+fn remove_no_follow(path: &Path) -> anyhow::Result<()> {
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error.into()),
+    };
+    if link_or_reparse(&metadata) {
+        unlink_link_or_reparse(path, &metadata)?;
+    } else if metadata.is_dir() {
+        for entry in fs::read_dir(path)?.flatten() {
+            remove_no_follow(&entry.path())?;
+        }
+        fs::remove_dir(path)?;
+    } else {
+        fs::remove_file(path)?;
+    }
+    Ok(())
+}
+
+/// Recover folders moved aside by an interrupted replacement without following links.
+pub fn recover_tmp(addons_dir: &Path) -> anyhow::Result<()> {
+    let temp = addons_dir.join(TMP_DIR);
+    let metadata = match fs::symlink_metadata(&temp) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error.into()),
+    };
+    if link_or_reparse(&metadata) || !metadata.is_dir() {
+        return remove_no_follow(&temp);
+    }
+    for entry in fs::read_dir(&temp)?.flatten() {
+        let work = entry.path();
+        let metadata = fs::symlink_metadata(&work)?;
+        if link_or_reparse(&metadata) || !metadata.is_dir() {
+            remove_no_follow(&work)?;
+            continue;
+        }
+        let old = work.join("old");
+        match fs::symlink_metadata(&old) {
+            Ok(metadata) if !link_or_reparse(&metadata) && metadata.is_dir() => {
+                for entry in fs::read_dir(&old)?.flatten() {
+                    let backup = entry.path();
+                    let metadata = fs::symlink_metadata(&backup)?;
+                    if link_or_reparse(&metadata) || !metadata.is_dir() {
+                        remove_no_follow(&backup)?;
+                        continue;
+                    }
+                    let name = backup.file_name().and_then(|name| name.to_str())
+                        .ok_or_else(|| anyhow!("invalid interrupted backup name"))?;
+                    if name.is_empty() || name.starts_with('.') || name.contains("..") ||
+                        name.contains(['/', '\\']) {
+                        anyhow::bail!("refusing suspicious interrupted backup {name}");
+                    }
+                    let target = addons_dir.join(name);
+                    if fs::symlink_metadata(&target).is_ok() {
+                        remove_no_follow(&backup)?;
+                    } else {
+                        fs::rename(&backup, &target)
+                            .with_context(|| format!("restore interrupted addon {name}"))?;
+                    }
+                }
+            }
+            Ok(_) => remove_no_follow(&old)?,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error.into()),
+        }
+        remove_no_follow(&work)?;
+    }
+    remove_no_follow(&temp)
+}
+
+fn tidy_operation(addons_dir: &Path, work: &Path, zip_path: &Path) {
+    let _ = remove_no_follow(work);
+    let _ = fs::remove_file(zip_path);
+    if let Some(downloads) = zip_path.parent() {
+        let _ = fs::remove_dir(downloads);
+    }
+    let _ = fs::remove_dir(addons_dir.join(TMP_DIR));
 }
 
