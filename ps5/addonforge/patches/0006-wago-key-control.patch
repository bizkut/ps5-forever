+async fn wago_key_status(app: &App) -> Value {
+    let set = app.state.lock().await.has_wago_key();
+    let valid = if set { *app.wago_valid.lock().await } else { None };
+    serde_json::json!({"set": set, "valid": valid})
+}
+
+fn trimmed_wago_key(key: &str) -> Result<&str, String> {
+    let key = key.trim();
+    if key.len() > 256 || key.bytes().any(|byte| !(0x21..=0x7e).contains(&byte)) {
+        return Err("Wago key must be at most 256 characters, without spaces or control characters.".into());
+    }
+    Ok(key)
+}
+
+async fn check_wago_key_at(client: &reqwest::Client, key: &str, endpoint: &str) -> Option<bool> {
+    // Never expose the response body, request headers, or transport error.
+    let response = client.get(endpoint).bearer_auth(key)
+        .header(reqwest::header::ACCEPT, "application/json")
+        .timeout(std::time::Duration::from_secs(8)).send().await.ok()?;
+    if response.url().as_str() != endpoint {
+        return None;
+    }
+    match response.status().as_u16() {
+        401 | 403 => Some(false),
+        200..=299 if response.headers().get(reqwest::header::CONTENT_TYPE)
+            .and_then(|value| value.to_str().ok())
+            .is_some_and(|value| value.split(';').next() == Some("application/json")) => Some(true),
+        _ => None,
+    }
+}
+
+async fn store_wago_key(app: &App, key: &str, valid: Option<bool>) -> Result<Value, String> {
+    let key = trimmed_wago_key(key)?;
+    if !key.is_empty() && valid == Some(false) {
+        return Err("Wago rejected this key.".into());
+    }
+    let mut state = app.state.lock().await;
+    let mut next = state.clone();
+    next.wago_key = if key.is_empty() { None } else { Some(key.to_owned()) };
+    next.save().map_err(|_| "Could not save the Wago key.".to_string())?;
+    *state = next;
+    let set = state.has_wago_key();
+    let valid = if set { valid } else { None };
+    *app.wago_valid.lock().await = valid;
+    Ok(serde_json::json!({"set": set, "valid": valid}))
+}
+
+async fn set_wago_key_impl(app: &App, key: &str) -> Result<Value, String> {
+    let key = trimmed_wago_key(key)?;
+    let valid = if key.is_empty() { None } else {
+        // The collection URL redirects to a public homepage, even with a bad key.
+        // A read-only addon metadata request actually requires authentication.
+        check_wago_key_at(&app.client, key,
+            "https://addons.wago.io/api/external/addons/7x61oyG1?game_version=forever").await
+    };
+    store_wago_key(app, key, valid).await
+}
