+    pub fn select_install(&mut self, path: String) {
+        let key = path.replace('\\', "/").to_ascii_lowercase();
+        let previous = self.install_path.as_deref().map(|s| s.replace('\\', "/").to_ascii_lowercase());
+        if previous.as_deref() == Some(key.as_str()) { return; }
+        if let Some(previous) = previous {
+            self.channels.insert(previous, ChannelState {
+                installed: std::mem::take(&mut self.installed),
+                pinned: std::mem::take(&mut self.pinned),
+                ignored: std::mem::take(&mut self.ignored),
+            });
+        }
+        let channel = self.channels.remove(&key).unwrap_or_default();
+        self.installed = channel.installed;
+        self.pinned = channel.pinned;
+        self.ignored = channel.ignored;
+        self.install_path = Some(path);
