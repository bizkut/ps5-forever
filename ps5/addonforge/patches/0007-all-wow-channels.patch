+//! Source capability vocabulary. Discovery/launch never uses this allow-list.
+use std::path::Path;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Flavor { Retail, Classic, Bc, Wrath, Cata, Mists, Forever }
+pub const UNSUPPORTED: &str = "Add-ons aren't supported for this WoW version yet";
+impl Default for Flavor { fn default() -> Self { Self::Forever } }
+impl Flavor {
+    pub fn id(self) -> &'static str {
+        match self {
+            Self::Retail => "retail", Self::Classic => "classic", Self::Bc => "bc",
+            Self::Wrath => "wrath", Self::Cata => "cata", Self::Mists => "mists",
+            Self::Forever => "forever",
+        }
+    }
+    // Wago's vocabulary differs from BigWigs/TOC's mists/wrath.
+    pub fn wago(self) -> &'static str {
+        match self { Self::Mists => "mop", Self::Wrath => "wotlk", _ => self.id() }
+    }
+    pub fn accepts_interface(self, interface: u32) -> bool {
+        match self {
+            Self::Retail => interface >= 60000,
+            Self::Classic => (10000..16000).contains(&interface),
+            Self::Forever => (16000..17000).contains(&interface),
+            Self::Bc => (20000..30000).contains(&interface),
+            Self::Wrath => (30000..40000).contains(&interface),
+            Self::Cata => (40000..50000).contains(&interface),
+            Self::Mists => (50000..60000).contains(&interface),
+        }
+    }
+    pub fn accepts_patch(self, patch: &str) -> bool {
+        let mut parts = patch.split('.');
+        let interface = (|| interface_from_version(parts.next()?.parse().ok()?,
+            parts.next()?.parse().ok()?, parts.next()?.parse().ok()?))();
+        interface.is_some_and(|n| self.accepts_interface(n))
+    }
+    pub fn accepts_metadata(self, name: &str, interface: u32) -> bool {
+        if interface != 0 { return self.accepts_interface(interface); }
+        match self {
+            Self::Retail => matches!(name, "retail" | "mainline"),
+            Self::Classic => matches!(name, "classic" | "vanilla"),
+            Self::Bc => matches!(name, "bc" | "bcc" | "tbc"),
+            Self::Wrath => matches!(name, "wrath" | "wotlk"),
+            Self::Cata => name == "cata",
+            Self::Mists => matches!(name, "mists" | "mop"),
+            Self::Forever => matches!(name, "forever" | "camelot"),
+        }
+    }
+    pub fn accepts_toc_suffix(self, suffix: &str) -> bool {
+        self.accepts_metadata(suffix, 0) || (self == Self::Wrath && suffix == "wotlkc")
+    }
+    pub fn asset_flavor(name: &str) -> Option<Self> {
+        let lower = name.to_ascii_lowercase();
+        lower.split(|c: char| !c.is_ascii_alphanumeric()).filter_map(|t| match t {
+            "mainline" | "retail" => Some(Self::Retail), "classic" | "vanilla" => Some(Self::Classic),
+            "bc" | "bcc" | "tbc" => Some(Self::Bc), "wrath" | "wotlk" => Some(Self::Wrath),
+            "cata" => Some(Self::Cata), "mists" | "mop" => Some(Self::Mists),
+            "forever" | "camelot" => Some(Self::Forever), _ => None,
+        }).last()
+    }
+    pub fn asset_matches(self, name: &str) -> bool {
+        Self::asset_flavor(name) == Some(self)
+    }
+}
+pub fn interface_from_version(major: u32, minor: u32, patch: u32) -> Option<u32> {
+    if major == 0 || minor > 99 || patch > 99 { return None; }
+    major.checked_mul(10000)?.checked_add(minor * 100 + patch)
+}
+fn from_interface(interface: u32) -> Option<Flavor> {
+    [Flavor::Retail, Flavor::Classic, Flavor::Bc, Flavor::Wrath, Flavor::Cata,
+     Flavor::Mists, Flavor::Forever].into_iter().find(|f| f.accepts_interface(interface))
+}
+pub fn for_product(product: &str, interface: u32) -> Option<Flavor> {
+    let fallback = match product {
+        "wow" | "wowt" | "wowxptr" | "wow_beta" => Flavor::Retail,
+        "wow_classic" | "wow_classic_ptr" => Flavor::Mists,
+        "wow_classic_beta" | "wowf" => Flavor::Forever,
+        "wow_classic_era" | "wow_classic_era_ptr" | "wow_classic_era_beta" => Flavor::Classic,
+        "wow_anniversary" => Flavor::Bc,
+        "wowe1" | "wowe2" | "wowe3" => return from_interface(interface),
+        _ => return None,
+    };
+    // The channel-local executable is authoritative when a beta/progression
+    // product changes engines. Never infer a version from transient .build.info.
+    if interface == 0 { return Some(fallback); }
+    let detected = from_interface(interface)?;
+    // A later Classic expansion must not silently become Retail. Unknown
+    // source capabilities fail closed, while known progression builds move.
+    if (detected == Flavor::Retail) != (fallback == Flavor::Retail) { return None; }
+    if (product == "wowf" || product.starts_with("wow_classic_era")) && detected != fallback {
+        return None;
+    }
+    Some(detected)
+}
+pub fn executable_name(name: &str) -> bool {
+    let lower = name.to_ascii_lowercase();
+    lower.strip_prefix("wow").and_then(|s| s.strip_suffix(".exe"))
+        .is_some_and(|s| s.bytes().all(|b| b.is_ascii_alphabetic()))
+}
+fn u16_at(bytes: &[u8], at: usize) -> Option<u16> {
+    Some(u16::from_le_bytes(bytes.get(at..at.checked_add(2)?)?.try_into().ok()?))
+}
+fn u32_at(bytes: &[u8], at: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(bytes.get(at..at.checked_add(4)?)?.try_into().ok()?))
+}
+fn version_resource(bytes: &[u8], resource_rva: u32) -> Option<u32> {
+    let mut directory = 0;
+    for depth in 0..3 {
+        let count = u16_at(bytes, directory + 12)? as usize + u16_at(bytes, directory + 14)? as usize;
+        let mut child = None;
+        for i in 0..count {
+            let entry = directory.checked_add(16 + i * 8)?;
+            let id = u32_at(bytes, entry)?;
+            if depth != 0 || id == 16 { child = Some(u32_at(bytes, entry + 4)?); break; }
+        }
+        let child = child?;
+        if depth < 2 && child & 0x80000000 == 0 { return None; }
+        directory = (child & 0x7fffffff) as usize;
+    }
+    let data = u32_at(bytes, directory)?.checked_sub(resource_rva)? as usize;
+    let size = u32_at(bytes, directory + 4)? as usize;
+    let data = bytes.get(data..data.checked_add(size)?)?;
+    // VS_VERSION_INFO's UTF-16 key precedes an aligned VS_FIXEDFILEINFO.
+    let key = b"V\0S\0_\0V\0E\0R\0S\0I\0O\0N\0_\0I\0N\0F\0O\0\0\0";
+    if data.get(6..6 + key.len())? != key { return None; }
+    let at = (6 + key.len() + 3) & !3;
+    if u32_at(data, at)? != 0xfeef04bd { return None; }
+    let ms = u32_at(data, at + 8)?;
+    let ls = u32_at(data, at + 12)?;
+    interface_from_version(ms >> 16, ms & 0xffff, ls >> 16)
+}
+pub fn client_interface(path: &Path) -> Option<u32> {
+    use std::io::{Read, Seek, SeekFrom};
+    let mut file = std::fs::File::open(path).ok()?;
+    let mut dos = [0; 64]; file.read_exact(&mut dos).ok()?;
+    if &dos[..2] != b"MZ" { return None; }
+    file.seek(SeekFrom::Start(u32_at(&dos, 60)? as u64)).ok()?;
+    let mut coff = [0; 24]; file.read_exact(&mut coff).ok()?;
+    if &coff[..4] != b"PE\0\0" { return None; }
+    let sections = u16_at(&coff, 6)? as usize;
+    let optional_size = u16_at(&coff, 20)? as usize;
+    if sections > 96 || optional_size > 4096 { return None; }
+    let mut optional = vec![0; optional_size]; file.read_exact(&mut optional).ok()?;
+    let dd = match u16_at(&optional, 0)? { 0x20b => 112, 0x10b => 96, _ => return None };
+    let rva = u32_at(&optional, dd + 16)?;
+    let size = u32_at(&optional, dd + 20)? as usize;
+    if rva == 0 || !(16..=2 * 1024 * 1024).contains(&size) { return None; }
+    for _ in 0..sections {
+        let mut section = [0; 40]; file.read_exact(&mut section).ok()?;
+        let start = u32_at(&section, 12)?;
+        let raw_size = u32_at(&section, 16)?;
+        if rva >= start && rva - start < raw_size && size <= (raw_size - (rva - start)) as usize {
+            let offset = u32_at(&section, 20)? as u64 + (rva - start) as u64;
+            file.seek(SeekFrom::Start(offset)).ok()?;
+            let mut bytes = vec![0; size]; file.read_exact(&mut bytes).ok()?;
+            return version_resource(&bytes, rva);
+        }
+    }
+    None
+}
