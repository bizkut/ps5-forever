+        assert_eq!(for_product("wowe1", 0), None);
+        assert_eq!(for_product("wow_classic", 60000), None);
+        assert_eq!(for_product("wow_classic_era", 120105), None);
+        assert_eq!(for_product("wowf", 120105), None);
+        assert_eq!(for_product("wow", 16001), None);
+        assert_eq!(Flavor::Mists.wago(), "mop");
