+/// The game chooses a matching flavour TOC before the generic TOC. Never
+/// merge metadata from other clients into its version or source identity.
+fn read_addon(directory: &Path, folder: &str, flavor: crate::flavor::Flavor) -> Option<AddonFolder> {
+    let mut selected: Option<(u8, String, AddonFolder)> = None;
+    for entry in fs::read_dir(directory).ok()?.flatten() {
+        let filename = entry.file_name().to_string_lossy().into_owned();
+        let Some((stem, extension)) = filename.rsplit_once('.') else { continue };
+        if !extension.eq_ignore_ascii_case("toc") { continue; }
+        let rank = if stem.eq_ignore_ascii_case(folder) { 1 } else {
+            if !stem.get(..folder.len()).is_some_and(|s| s.eq_ignore_ascii_case(folder)) { continue; }
+            let suffix = &stem[folder.len()..];
+            let Some(suffix) = suffix.strip_prefix('_').or_else(|| suffix.strip_prefix('-')) else { continue };
+            if !flavor.accepts_toc_suffix(&suffix.to_ascii_lowercase()) { continue; }
+            2
+        };
+        if selected.as_ref().is_some_and(|(previous, name, _)|
+            rank < *previous || (rank == *previous && filename >= *name)) { continue; }
+        let mut addon = AddonFolder { folder: folder.to_string(), ..Default::default() };
+        if parse_toc(&entry.path(), &mut addon) { selected = Some((rank, filename, addon)); }
+    }
+    selected.map(|(rank, _, mut addon)| {
+        if addon.title.is_empty() { addon.title = folder.to_string(); }
+        addon.forever_toc = rank == 2 && flavor == crate::flavor::Flavor::Forever;
+        addon.forever_interface = addon.interfaces.iter().any(|n| FOREVER_INTERFACE_RANGE.contains(n));
+        addon
+    })
+}
+
+/// Validate the selected client's TOC before replacing an installed folder.
+pub fn addon_supports(directory: &Path, flavor: crate::flavor::Flavor) -> bool {
+    directory.file_name().and_then(|n| n.to_str())
+        .and_then(|name| read_addon(directory, name, flavor))
+        .is_some_and(|addon| addon.interfaces.iter().any(|n| flavor.accepts_interface(*n)))
+}
