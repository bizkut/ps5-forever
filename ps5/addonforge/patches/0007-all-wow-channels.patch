+#[cfg(test)]
+pub fn fixture_pe(major: u32, minor: u32, patch: u32) -> Vec<u8> {
+    fn p16(b: &mut [u8], at: usize, n: u16) { b[at..at + 2].copy_from_slice(&n.to_le_bytes()); }
+    fn p32(b: &mut [u8], at: usize, n: u32) { b[at..at + 4].copy_from_slice(&n.to_le_bytes()); }
+    let mut bytes = vec![0; 0x600];
+    bytes[..2].copy_from_slice(b"MZ"); p32(&mut bytes, 60, 0x80);
+    bytes[0x80..0x84].copy_from_slice(b"PE\0\0");
+    p16(&mut bytes, 0x86, 1); p16(&mut bytes, 0x94, 240);
+    p16(&mut bytes, 0x98, 0x20b);
+    p32(&mut bytes, 0x98 + 128, 0x1000); p32(&mut bytes, 0x98 + 132, 0x200);
+    p32(&mut bytes, 0x188 + 12, 0x1000); p32(&mut bytes, 0x188 + 16, 0x200);
+    p32(&mut bytes, 0x188 + 20, 0x400);
+    let r = &mut bytes[0x400..];
+    p16(r, 14, 1); p32(r, 16, 16); p32(r, 20, 0x80000018);
+    p16(r, 0x18 + 14, 1); p32(r, 0x18 + 16, 1); p32(r, 0x18 + 20, 0x80000030);
+    p16(r, 0x30 + 14, 1); p32(r, 0x30 + 16, 0x409); p32(r, 0x30 + 20, 0x48);
+    p32(r, 0x48, 0x1060); p32(r, 0x4c, 92);
+    let v = &mut r[0x60..];
+    p16(v, 0, 92); p16(v, 2, 52);
+    v[6..38].copy_from_slice(b"V\0S\0_\0V\0E\0R\0S\0I\0O\0N\0_\0I\0N\0F\0O\0\0\0");
+    p32(v, 40, 0xfeef04bd); p32(v, 48, (major << 16) | minor);
+    p32(v, 52, patch << 16);
+    bytes
+}
