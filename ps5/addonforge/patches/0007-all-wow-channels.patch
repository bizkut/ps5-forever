+            ("wow_classic_era", 11509, Flavor::Classic), ("wow_classic_era_ptr", 11509, Flavor::Classic),
+            ("wow_anniversary", 20506, Flavor::Bc), ("wowe1", 11509, Flavor::Classic),
+            ("wow_classic", 40402, Flavor::Cata), ("wow_classic", 30403, Flavor::Wrath),
