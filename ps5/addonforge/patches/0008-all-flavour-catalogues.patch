+pub const CACHE_TTL: Duration = Duration::from_secs(6 * 60 * 60);
+pub const WOWI_LIST: &str = "https://api.mmoui.com/v4/game/WOW/filelist.json";
+pub const TUKUI_LIST: &str = "https://api.tukui.org/v1/addons";
