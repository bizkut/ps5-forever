+/// Small author-release pointers verified for every supported family by the
+/// live qualification test. Resolution and archive admission still recheck
+/// the selected flavour at install/update time.
+fn compose(flavor: crate::flavor::Flavor, mut cat: Catalog,
+           public: Vec<CatalogEntry>) -> Catalog {
+    cat.flavor = flavor.id().into();
+    let five_families = matches!(flavor, crate::flavor::Flavor::Retail | crate::flavor::Flavor::Mists
+        | crate::flavor::Flavor::Bc | crate::flavor::Flavor::Classic | crate::flavor::Flavor::Forever);
+    for (id, name, repo, folder, only_five) in [
+        ("betterbags", "BetterBags", "Cidan/BetterBags", "BetterBags", true),
+        ("bagsync", "BagSync", "Xruptor/BagSync", "BagSync", false),
+        ("improve-any", "ImproveAny", "d4kir92/ImproveAny", "ImproveAny", false),
+        ("minimap-button-button", "MinimapButtonButton", "syndenbock/MinimapButtonButton", "MinimapButtonButton", false),
+        ("immersion", "Immersion", "seblindfors/Immersion", "Immersion", true),
+        ("xanchat", "XanChat", "Xruptor/XanChat", "XanChat", false),
+    ] {
+        if only_five && !five_families { continue; }
+        if !cat.addons.iter().any(|e| e.id == id) {
+            cat.addons.push(CatalogEntry {
+                id: id.into(), name: name.into(), github: Some(repo.into()),
+                folders: vec![folder.into()], desc: "GitHub author release".into(),
+                forever: Some(true), ..Default::default()
+            });
+        }
+    }
+    let has_elvui = matches!(flavor, crate::flavor::Flavor::Retail | crate::flavor::Flavor::Mists
+        | crate::flavor::Flavor::Bc | crate::flavor::Flavor::Classic);
+    if has_elvui {
+        cat.addons.push(CatalogEntry {
+            id: "tukui-elvui".into(), name: "ElvUI".into(), tukui: Some("elvui".into()),
+            folders: vec!["ElvUI".into(), "ElvUI_Libraries".into(), "ElvUI_Options".into()],
+            desc: "Tukui · complete interface replacement".into(),
+            forever: Some(true), ..Default::default()
+        });
+    }
+    for entry in public {
+        if let Some(existing) = cat.addons.iter_mut().find(|e|
+            e.id == entry.id || (entry.github.as_ref().is_some_and(|repo|
+                e.github.as_ref().is_some_and(|other| repo.eq_ignore_ascii_case(other))))
+                || (entry.github.is_none() && entry.wowi.is_some() && e.wowi == entry.wowi)
+                || (entry.tukui.is_some() && e.tukui == entry.tukui)) {
+            if existing.id.starts_with("tukui-") { *existing = entry; }
+        } else { cat.addons.push(entry); }
+    }
+    cat.bundles = vec![
+        Bundle { id: "quality-of-life".into(), name: "Quality of life".into(),
+            desc: "Small interface fixes and a tidy minimap.".into(),
+            addons: vec!["improve-any".into(), "minimap-button-button".into()],
+            note: "Author GitHub releases; no API key needed.".into() },
+        Bundle { id: "bags".into(), name: "Bags and inventory".into(),
+            desc: "BetterBags and cross-character item tracking with BagSync.".into(),
+            addons: if five_families { vec!["betterbags".into(), "bagsync".into()] } else { vec!["bagsync".into()] },
+            note: "Author GitHub releases; no API key needed.".into() },
+        Bundle { id: "chat-quests".into(), name: "Chat and quest text".into(),
+            desc: "XanChat and Immersion's quest dialogue.".into(),
+            addons: if five_families { vec!["xanchat".into(), "immersion".into()] } else { vec!["xanchat".into()] },
+            note: "Author GitHub releases; no API key needed.".into() },
+    ];
+    if has_elvui {
+        cat.bundles.push(Bundle { id: "interface".into(), name: "User interface".into(),
+            desc: "ElvUI's complete interface replacement.".into(),
+            addons: vec!["tukui-elvui".into()], note: "Tukui author download; no API key needed.".into() });
+    }
+    cat.addons.sort_by_cached_key(|e| e.name.to_lowercase());
+    cat
+}
