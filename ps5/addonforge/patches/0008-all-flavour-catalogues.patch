+                let mut request = [0;4096]; let count = stream.read(&mut request).unwrap();
+                if i == 0 {
+                    write!(stream, "HTTP/1.1 200 OK\r\nETag: \"fixture\"\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{CSV_FIXTURE}", CSV_FIXTURE.len()).unwrap();
