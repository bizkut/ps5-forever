+    #[test]
+    fn cache_replacement_preserves_last_good_until_success_and_on_failure() {
+        let dir = std::env::temp_dir().join(format!("af-cache-replace-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("catalogue.json");
+        let old = br#"{"fetched_at":1,"data":[{"id":42}]}"#;
+        let new = br#"{"fetched_at":2,"data":[{"id":43}]}"#;
+        std::fs::write(&path, old).unwrap();
+        store_cache_with(&path, new, |temporary, destination| {
+            assert_eq!(std::fs::read(destination).unwrap(), old);
+            assert_eq!(std::fs::read(temporary).unwrap(), new);
+            std::fs::rename(temporary, destination)
+        }).unwrap();
+        assert_eq!(std::fs::read(&path).unwrap(), new);
+
+        std::fs::write(&path, old).unwrap();
+        let result = store_cache_with(&path, new, |temporary, destination| {
+            assert_eq!(std::fs::read(destination).unwrap(), old);
+            assert_eq!(std::fs::read(temporary).unwrap(), new);
+            Err(std::io::Error::new(std::io::ErrorKind::PermissionDenied, "forced replacement failure"))
+        });
+        assert_eq!(result.unwrap_err().kind(), std::io::ErrorKind::PermissionDenied);
+        assert_eq!(std::fs::read(&path).unwrap(), old);
+        assert!(!path.with_extension("tmp").exists());
+        store_cache(&path, new).unwrap();
+        assert_eq!(std::fs::read(&path).unwrap(), new);
+        std::fs::remove_dir_all(dir).unwrap();
+    }
