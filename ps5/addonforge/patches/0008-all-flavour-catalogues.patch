+/// Current engines, not historical 5.4/1.12 or obsolete Retail expansions.
+/// PTR/beta use the selected base flavour from flavor::for_product.
+pub fn current_patch(flavor: crate::flavor::Flavor, patch: &str) -> bool {
+    use crate::flavor::Flavor::*;
+    let prefix = match flavor {
+        Retail => "12.", Mists => "5.5.", Bc => "2.5.", Classic => "1.15.",
+        Forever => "1.60.", Wrath => "3.4.", Cata => "4.4.",
+    };
+    patch.starts_with(prefix) && flavor.accepts_patch(patch)
+}
+
+fn compatible(value: &serde_json::Value, key: &str, flavor: crate::flavor::Flavor) -> bool {
+    value[key].as_array().is_some_and(|versions|
+        versions.iter().filter_map(|v| v.as_str()).any(|p| current_patch(flavor, p)))
+}
+
+fn public_entries(wowi: &serde_json::Value, tukui: &serde_json::Value,
+                  flavor: crate::flavor::Flavor) -> Vec<CatalogEntry> {
+    let mut entries = Vec::new();
+    for file in wowi.as_array().into_iter().flatten() {
+        if !compatible(file, "gameVersions", flavor) || file["library"] == true { continue; }
+        let (Some(id), Some(name)) = (file["id"].as_u64(), file["title"].as_str()) else { continue };
+        entries.push(CatalogEntry {
+            id: format!("wowi-{id}"), name: name.into(), wowi: Some(id),
+            desc: format!("WoWInterface · {}", file["author"].as_str().unwrap_or("")),
+            url: Some(format!("https://www.wowinterface.com/downloads/info{id}")),
+            forever: Some(true), ..Default::default()
+        });
+    }
+    for addon in tukui.as_array().into_iter().flatten() {
+        if !compatible(addon, "patch", flavor) || addon["url"].as_str().is_none_or(|s| s.is_empty()) { continue; }
+        let (Some(slug), Some(name)) = (addon["slug"].as_str(), addon["name"].as_str()) else { continue };
+        entries.push(CatalogEntry {
+            id: format!("tukui-{slug}"), name: name.into(), tukui: Some(slug.into()),
+            desc: addon["small_desc"].as_str().unwrap_or("Tukui").into(),
+            folders: addon["directories"].as_array().into_iter().flatten()
+                .filter_map(|v| v.as_str().map(str::to_owned)).collect(),
+            url: Some(format!("https://tukui.org/{slug}")),
+            forever: Some(true), ..Default::default()
+        });
+    }
+    entries
+}
