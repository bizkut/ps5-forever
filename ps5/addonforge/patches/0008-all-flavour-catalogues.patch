+pub async fn load_for(client: &reqwest::Client, flavor: crate::flavor::Flavor,
+                      dir: &std::path::Path, refresh: bool) -> (Catalog, &'static str) {
+    let wowi_path = dir.join("wowi-v4.json");
+    let tukui_path = dir.join("tukui-v1.json");
+    let forever_path = dir.join("forever.json");
+    let github_path = dir.join("github-index.json");
+    let (github, wowi, tukui, forever) = tokio::join!(
+        github_index(client, GITHUB_URL, &github_path, refresh),
+        cached_json(client, WOWI_LIST, &wowi_path, refresh, |v| v.as_array().is_some_and(|a|
+            a.iter().any(|e| e["id"].is_u64() && e["title"].is_string() && e["gameVersions"].is_array()))),
+        cached_json(client, TUKUI_LIST, &tukui_path, refresh, |v| v.as_array().is_some_and(|a|
+            a.iter().any(|e| e["slug"].is_string() && e["patch"].is_array()))),
+        async {
+            if flavor == crate::flavor::Flavor::Forever {
+                cached_json(client, REMOTE_URL, &forever_path, refresh, |v|
+                    serde_json::from_value::<Catalog>(v.clone()).is_ok_and(|c|
+                        c.flavor == "forever" && !c.addons.is_empty())).await
+            } else { None }
+        },
+    );
+    let base = if flavor == crate::flavor::Flavor::Forever {
+        let local = bundled();
+        forever.and_then(|v| serde_json::from_value::<Catalog>(v).ok())
+            .filter(|c| c.updated >= local.updated).unwrap_or(local)
+    } else { Catalog::default() };
+    let mut public = github_entries(&github, flavor);
+    public.extend(public_entries(&wowi.unwrap_or_default(), &tukui.unwrap_or_default(), flavor));
+    (compose(flavor, base, public), "GitHub catalogue + secondary public indexes")
+}
