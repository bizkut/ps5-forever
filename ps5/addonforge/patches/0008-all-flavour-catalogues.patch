+#[derive(Serialize, Deserialize)]
+struct CachedGithub {
+    fetched_at: u64,
+    etag: Option<String>,
+    text: String,
+}
+
+fn size_error() -> std::io::Error {
+    std::io::Error::new(std::io::ErrorKind::InvalidData, "catalogue size limit exceeded")
+}
+
+fn read_cache(path: &std::path::Path) -> std::io::Result<Vec<u8>> {
+    use std::io::Read;
+    let file = std::fs::File::open(path)?;
+    let size = file.metadata()?.len();
+    if size > MAX_CACHE_BYTES as u64 { return Err(size_error()); }
+    let mut bytes = Vec::with_capacity(size as usize);
+    file.take(MAX_CACHE_BYTES as u64 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > MAX_CACHE_BYTES { return Err(size_error()); }
+    Ok(bytes)
+}
+
+async fn read_index(response: reqwest::Response) -> Option<Vec<u8>> {
+    use futures_util::StreamExt;
+    if response.content_length().is_some_and(|size| size > MAX_INDEX_BYTES as u64) { return None; }
+    let mut bytes = Vec::with_capacity(response.content_length().unwrap_or(4096) as usize);
+    let mut stream = response.bytes_stream();
+    while let Some(chunk) = stream.next().await {
+        let chunk = chunk.ok()?;
+        if chunk.len() > MAX_INDEX_BYTES - bytes.len() { return None; }
+        bytes.extend_from_slice(&chunk);
+    }
+    Some(bytes)
+}
+
+fn encode_cache(value: &impl Serialize) -> Result<Vec<u8>, serde_json::Error> {
+    struct Bounded(Vec<u8>);
+    impl std::io::Write for Bounded {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if bytes.len() > MAX_CACHE_BYTES - self.0.len() { return Err(size_error()); }
+            self.0.extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+    }
+    let mut output = Bounded(Vec::new());
+    serde_json::to_writer(&mut output, value)?;
+    Ok(output.0)
+}
+
+fn store_cache(path: &std::path::Path, bytes: &[u8]) -> std::io::Result<()> {
+    store_cache_with(path, bytes, |from, to| std::fs::rename(from, to))
+}
+
+fn store_cache_with(
+    path: &std::path::Path, bytes: &[u8],
+    replace: impl FnOnce(&std::path::Path, &std::path::Path) -> std::io::Result<()>,
+) -> std::io::Result<()> {
+    use std::io::Write;
+    if bytes.len() > MAX_CACHE_BYTES { return Err(size_error()); }
+    if let Some(parent) = path.parent() { std::fs::create_dir_all(parent)?; }
+    let temporary = path.with_extension("tmp");
+    let result = (|| {
+        let mut file = std::fs::File::create(&temporary)?;
+        file.write_all(bytes)?;
+        file.sync_all()?;
+        drop(file);
+        // std::fs::rename atomically replaces files on Unix and Windows
+        // (MoveFileExW/SetFileInformationByHandle). Never unlink the last good
+        // destination: a failed replacement must leave it intact.
+        replace(&temporary, path)
+    })();
+    if result.is_err() { let _ = std::fs::remove_file(&temporary); }
+    result
+}
+
+async fn github_index(client: &reqwest::Client, url: &str,
+                      path: &std::path::Path, refresh: bool) -> Vec<GithubRow> {
+    let cached = read_cache(path).ok()
+        .and_then(|bytes| serde_json::from_slice::<CachedGithub>(&bytes).ok())
+        .filter(|c| parse_github(&c.text).is_ok());
+    if !refresh && cached.as_ref().is_some_and(|c|
+        c.fetched_at <= now() && now() - c.fetched_at < GITHUB_TTL.as_secs()) {
+        return parse_github(&cached.unwrap().text).unwrap();
+    }
+    let fetched = async {
+        let mut request = client.get(url).timeout(Duration::from_secs(6));
+        if let Some(etag) = cached.as_ref().and_then(|c| c.etag.as_ref()) {
+            request = request.header(reqwest::header::IF_NONE_MATCH, etag);
+        }
+        let response = request.send().await.ok()?;
+        if response.status() == reqwest::StatusCode::NOT_MODIFIED {
+            return cached.as_ref().map(|c| CachedGithub {
+                fetched_at: now(), etag: c.etag.clone(), text: c.text.clone() });
+        }
+        let response = response.error_for_status().ok()?;
+        let etag = response.headers().get(reqwest::header::ETAG)
+            .and_then(|h| h.to_str().ok()).map(str::to_owned);
+        let text = String::from_utf8(read_index(response).await?).ok()?;
+        parse_github(&text).ok()?;
+        Some(CachedGithub { fetched_at: now(), etag, text })
+    }.await;
+    if let Some(record) = fetched {
+        if let Ok(bytes) = encode_cache(&record) {
+            let _ = store_cache(path, &bytes);
+        }
+        parse_github(&record.text).unwrap()
+    } else {
+        cached.and_then(|c| parse_github(&c.text).ok())
+            .unwrap_or_else(|| parse_github(BUNDLED_GITHUB).expect("build-validated GitHub snapshot"))
+    }
+}
 
