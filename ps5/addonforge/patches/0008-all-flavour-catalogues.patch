+    async fn oversized_live_and_cached_indexes_keep_last_good_or_bundled_fallback() {
+        use std::io::Write;
+        let dir = std::env::temp_dir().join(format!("af-bounded-index-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let github_path = dir.join("github.json");
+        let json_path = dir.join("public.json");
+        let github = serde_json::to_vec(&CachedGithub {
+            fetched_at: now(), etag: None, text: CSV_FIXTURE.into(),
+        }).unwrap();
+        let public = serde_json::to_vec(&CachedJson {
+            fetched_at: now(), data: json!([{"id":42}]),
+        }).unwrap();
+        std::fs::write(&github_path, &github).unwrap();
+        std::fs::write(&json_path, &public).unwrap();
+        let client = reqwest::Client::new();
+        for lying_length in [false, true] {
+            let (url, server) = oversized_chunked_server(
+                CSV_FIXTURE.replace("42,Quoted", "99,Quoted"), b'\n', "", lying_length);
+            let rows = github_index(&client, &url, &github_path, true).await;
+            server.join().unwrap();
+            assert_eq!(rows[0].id, 42);
+            assert_eq!(std::fs::read(&github_path).unwrap(), github);
+
+            let (url, server) = oversized_chunked_server("[{\"id\":99,\"padding\":\"".into(), b'x', "\"}]", lying_length);
+            let data = cached_json(&client, &url, &json_path, true, |v| v.is_array()).await.unwrap();
+            server.join().unwrap();
+            assert_eq!(data[0]["id"], 42);
+            assert_eq!(std::fs::read(&json_path).unwrap(), public);
+        }
+
+        // Valid JSON with trailing whitespace would deserialize successfully
+        // without a pre-parse file bound.
+        let padding = vec![b' '; MAX_CACHE_BYTES + 1];
+        for path in [&github_path, &json_path] {
+            std::fs::OpenOptions::new().append(true).open(path).unwrap().write_all(&padding).unwrap();
+        }
+        assert_eq!(github_index(&client, "http://127.0.0.1:1", &github_path, false).await.len(),
+            parse_github(BUNDLED_GITHUB).unwrap().len());
+        assert!(cached_json(&client, "http://127.0.0.1:1", &json_path, false, |v| v.is_array()).await.is_none());
+        std::fs::write(&json_path, &public).unwrap();
+        assert_eq!(store_cache(&json_path, &padding).unwrap_err().kind(), std::io::ErrorKind::InvalidData);
+        assert_eq!(std::fs::read(&json_path).unwrap(), public);
+        // JSON string escaping must not allocate or promote a cache envelope
+        // beyond its bound even when the original index itself fits.
+        assert!(encode_cache(&json!({"text":"\0".repeat(MAX_CACHE_BYTES / 6 + 1)})).is_err());
+        std::fs::remove_dir_all(dir).unwrap();
+    }
