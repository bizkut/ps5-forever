+#[derive(Serialize, Deserialize)]
+struct CachedJson {
+    fetched_at: u64,
+    data: serde_json::Value,
+}
+
+fn now() -> u64 {
+    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default().as_secs()
+}
+
+async fn cached_json(
+    client: &reqwest::Client, url: &str, path: &std::path::Path, refresh: bool,
+    valid: impl Fn(&serde_json::Value) -> bool,
+) -> Option<serde_json::Value> {
+    let cached = read_cache(path).ok()
+        .and_then(|bytes| serde_json::from_slice::<CachedJson>(&bytes).ok())
+        .filter(|c| valid(&c.data));
+    if !refresh && cached.as_ref().is_some_and(|c|
+        c.fetched_at <= now() && now() - c.fetched_at < CACHE_TTL.as_secs()) {
+        return cached.map(|c| c.data);
+    }
+    let fetched = async {
+        let response = client.get(url).timeout(Duration::from_secs(6)).send().await.ok()?
+            .error_for_status().ok()?;
+        serde_json::from_slice::<serde_json::Value>(&read_index(response).await?).ok()
+    }.await.filter(|v| valid(v));
+    if let Some(data) = fetched {
+        let record = CachedJson { fetched_at: now(), data };
+        if let Ok(bytes) = encode_cache(&record) {
+            let _ = store_cache(path, &bytes);
+        }
+        Some(record.data)
+    } else {
+        cached.map(|c| c.data)
+    }
+}
