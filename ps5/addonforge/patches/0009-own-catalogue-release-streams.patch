+    #[test]
+    fn lore_archive_io_measurement_if_requested() {
+        let Some(path) = std::env::var_os("ADDONFORGE_LORE_ZIP") else { return };
+        struct CountedFile {
+            file: fs::File,
+            reads: u64,
+            bytes: u64,
+            seeks: u64,
+        }
+        impl std::io::Read for CountedFile {
+            fn read(&mut self, bytes: &mut [u8]) -> std::io::Result<usize> {
+                let count = self.file.read(bytes)?;
+                self.reads += 1;
+                self.bytes += count as u64;
+                Ok(count)
+            }
+        }
+        impl std::io::Seek for CountedFile {
+            fn seek(&mut self, position: std::io::SeekFrom) -> std::io::Result<u64> {
+                self.seeks += 1;
+                self.file.seek(position)
+            }
+        }
+        #[derive(Default)]
+        struct Sink { writes: u64, bytes: u64 }
+        impl std::io::Write for Sink {
+            fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+                self.writes += 1;
+                self.bytes += bytes.len() as u64;
+                Ok(bytes.len())
+            }
+            fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+        }
+        let reader = CountedFile {
+            file: fs::File::open(path).unwrap(), reads: 0, bytes: 0, seeks: 0};
+        let mut archive = zip::ZipArchive::new(reader).unwrap();
+        let mut sink = Sink::default();
+        let mut files = 0_u64;
+        let mut decompressed = 0_u64;
+        let mut previous_writes = 0_u64;
+        for index in 0..archive.len() {
+            let mut entry = archive.by_index(index).unwrap();
+            if entry.is_dir() { continue; }
+            files += 1;
+            previous_writes += entry.size().div_ceil(8192);
+            let size = entry.size();
+            decompressed += size;
+            copy_archive_entry(&mut entry, &mut sink, size).unwrap();
+        }
+        let reader = archive.into_inner();
+        println!(
+            "LORE_EXTRACT_IO files={files} writes_before={previous_writes} writes_after={} \
+             read_calls={} read_bytes={} seeks={} pathological_bufread_bytes={}",
+            sink.writes, reader.reads, reader.bytes, reader.seeks,
+            files * DOWNLOAD_WRITE_BUFFER as u64);
+        assert_eq!(sink.bytes, decompressed);
+        assert_eq!(sink.writes, files);
+        assert!(reader.bytes < 500 * 1024 * 1024);
+    }
