+const EXTRACT_SINGLE_WRITE_CAP: u64 = 64 * 1024 * 1024;
+const EXTRACT_WRITE_CHUNK: usize = 4 * 1024 * 1024;
+
+fn copy_archive_entry(
+    reader: &mut impl std::io::Read,
+    writer: &mut impl std::io::Write,
+    size: u64,
+) -> std::io::Result<usize> {
+    if size <= EXTRACT_SINGLE_WRITE_CAP {
+        let mut bytes = vec![0; usize::try_from(size).unwrap_or(usize::MAX)];
+        reader.read_exact(&mut bytes)?;
+        writer.write_all(&bytes)?;
+        return Ok(1);
+    }
+    let mut buffer = vec![0; EXTRACT_WRITE_CHUNK];
+    let mut remaining = size;
+    let mut writes = 0;
+    while remaining > 0 {
+        let count = buffer.len().min(remaining as usize);
+        reader.read_exact(&mut buffer[..count])?;
+        writer.write_all(&buffer[..count])?;
+        remaining -= count as u64;
+        writes += 1;
+    }
+    Ok(writes)
+}
+
+fn extract_archive(
+    archive: &mut zip::ZipArchive<fs::File>,
+    destination: &Path,
+    progress: &mut impl FnMut(usize, usize),
+) -> anyhow::Result<()> {
+    let total = (0..archive.len())
+        .filter(|index| archive.by_index(*index).is_ok_and(|entry| !entry.is_dir()))
+        .count();
+    let mut completed = 0;
+    for index in 0..archive.len() {
+        let mut entry = archive.by_index(index)?;
+        let relative = entry.enclosed_name()
+            .ok_or_else(|| anyhow!("zip contains an unsafe path"))?
+            .to_path_buf();
+        let path = destination.join(relative);
+        if entry.is_dir() {
+            fs::create_dir_all(&path)?;
+            continue;
+        }
+        if let Some(parent) = path.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        let mut output = fs::File::create(&path)?;
+        let size = entry.size();
+        copy_archive_entry(&mut entry, &mut output, size)?;
+        output.flush()?;
+        completed += 1;
+        progress(completed, total);
+    }
+    Ok(())
+}
