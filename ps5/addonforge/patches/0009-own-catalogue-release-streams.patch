+    #[test]
+    fn lore_sized_stream_is_coalesced_into_large_disk_writes() {
+        #[derive(Default)]
+        struct Writes { calls: usize, bytes: u64 }
+        impl std::io::Write for Writes {
+            fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+                self.calls += 1;
+                self.bytes += bytes.len() as u64;
+                Ok(bytes.len())
+            }
+            fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+        }
+        let total = 358_u64 * 1024 * 1024;
+        let chunk = vec![0; 7 * 1024];
+        let raw_calls = total.div_ceil(chunk.len() as u64);
+        let mut remaining = total;
+        let mut writer = std::io::BufWriter::with_capacity(
+            DOWNLOAD_WRITE_BUFFER, Writes::default());
+        while remaining > 0 {
+            let count = chunk.len().min(remaining as usize);
+            writer.write_all(&chunk[..count]).unwrap();
+            remaining -= count as u64;
+        }
+        writer.flush().unwrap();
+        assert_eq!(writer.get_ref().bytes, total);
+        assert!(raw_calls > 50_000);
+        assert!(writer.get_ref().calls <= 46, "writes={}", writer.get_ref().calls);
+        println!("LORE_DOWNLOAD_WRITES before={raw_calls} after={}",
+            writer.get_ref().calls);
+    }
+
+    #[test]
+    fn decompressed_entries_use_one_write_or_four_mib_chunks() {
+        struct Zeros(u64);
+        impl std::io::Read for Zeros {
+            fn read(&mut self, bytes: &mut [u8]) -> std::io::Result<usize> {
+                let count = bytes.len().min(self.0 as usize);
+                bytes[..count].fill(0);
+                self.0 -= count as u64;
+                Ok(count)
+            }
+        }
+        #[derive(Default)]
+        struct Writes { calls: usize, bytes: u64 }
+        impl std::io::Write for Writes {
+            fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+                self.calls += 1;
+                self.bytes += bytes.len() as u64;
+                Ok(bytes.len())
+            }
+            fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+        }
+        let mut small = Writes::default();
+        copy_archive_entry(
+            &mut Zeros(8 * 1024 * 1024), &mut small, 8 * 1024 * 1024).unwrap();
+        assert_eq!((small.calls, small.bytes), (1, 8 * 1024 * 1024));
+
+        let size = 358_u64 * 1024 * 1024;
+        let mut large = Writes::default();
+        copy_archive_entry(&mut Zeros(size), &mut large, size).unwrap();
+        assert_eq!(large.bytes, size);
+        assert_eq!(large.calls, 90);
+    }
