+fn asset_pattern_matches(pattern: &str, name: &str) -> bool {
+    let pattern = pattern.to_ascii_lowercase();
+    let name = name.to_ascii_lowercase();
+    let mut parts = pattern.split('*');
+    let first = parts.next().unwrap_or("");
+    let second = parts.next();
+    if parts.next().is_some() {
+        return false;
+    }
+    match second {
+        None => name == first,
+        Some(suffix) => name.len() >= first.len() + suffix.len()
+            && name.starts_with(first) && name.ends_with(suffix),
+    }
+}
+
+fn pick_pattern_asset<'a>(
+    zips: &[&'a ApiAsset], pattern: &str,
+) -> anyhow::Result<&'a ApiAsset> {
+    let matches: Vec<_> = zips.iter().copied()
+        .filter(|asset| asset_pattern_matches(pattern, &asset.name)).collect();
+    anyhow::ensure!(matches.len() == 1,
+        "asset pattern {pattern:?} matched {} zip assets", matches.len());
+    Ok(matches[0])
+}
+
+fn pick_release<'a>(
+    releases: &'a [ApiRelease], tag_prefix: Option<&str>, prerelease: bool,
+) -> Option<&'a ApiRelease> {
