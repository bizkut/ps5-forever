+// Native Forever add-on archive worker client. The authenticated helper owns
+// staging and activation; the core admits the immutable extracted contents.
+use anyhow::{anyhow, Context};
+use futures_util::StreamExt;
+use sha2::{Digest as ShaDigest, Sha256};
+use std::io::{Read, Write};
+use std::net::TcpStream;
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+const MAGIC: u32 = 0x3157_4146;
+const VERSION: u32 = 2;
+const PORT: u16 = 9142;
+const TOKEN_BYTES: usize = 64;
+const OPERATION_BYTES: usize = 32;
+const MAX_ARCHIVE_BYTES: u64 = 4 * 1024 * 1024 * 1024;
+const HELLO_BYTES: usize = 8;
+const CHALLENGE_REPLY_BYTES: usize = 40;
+const AUTH_REPLY_BYTES: usize = 44;
+const REQUEST_BYTES: usize = 88;
+const REPLY_BYTES: usize = 100;
+const COMMAND_STORE: u32 = 2;
+const COMMAND_EXTRACT: u32 = 3;
+const COMMAND_CLEAN: u32 = 4;
+const COMMAND_ACTIVATE: u32 = 7;
+const PHASE_READY: u32 = 1;
+const PHASE_PROGRESS: u32 = 2;
+const PHASE_COMPLETE: u32 = 3;
+const WINDOWS_ROOT: &str = "C:\\Forever\\AddonStaging";
+
+fn put_u32(bytes: &mut [u8], value: u32) {
+    bytes[..4].copy_from_slice(&value.to_le_bytes());
+}
+
+fn put_u64(bytes: &mut [u8], value: u64) {
+    bytes[..8].copy_from_slice(&value.to_le_bytes());
+}
+
+fn get_u32(bytes: &[u8]) -> u32 {
+    u32::from_le_bytes(bytes[..4].try_into().unwrap())
+}
+
+fn get_i32(bytes: &[u8]) -> i32 {
+    i32::from_le_bytes(bytes[..4].try_into().unwrap())
+}
+
+fn get_u64(bytes: &[u8]) -> u64 {
+    u64::from_le_bytes(bytes[..8].try_into().unwrap())
+}
+
+fn operation_id(token: &str) -> String {
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_nanos())
+        .unwrap_or(0);
+    let mut hash = Sha256::new();
+    hash.update(token.as_bytes());
+    hash.update(nanos.to_le_bytes());
+    hash.update(std::process::id().to_le_bytes());
+    hash.finalize()[..16]
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+fn checked_token(token: &str) -> anyhow::Result<[u8; TOKEN_BYTES]> {
+    if token.len() != TOKEN_BYTES || !token.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        anyhow::bail!("native add-on worker token is invalid");
+    }
+    let mut bytes = [0; TOKEN_BYTES];
+    bytes.copy_from_slice(token.as_bytes());
+    Ok(bytes)
+}
+
+fn authentication_tag(
+    token: &[u8; TOKEN_BYTES],
+    challenge: &[u8; 32],
+    domain: u8,
+) -> [u8; 32] {
+    let mut inner_pad = [0u8; 64];
+    let mut outer_pad = [0u8; 64];
+    for index in 0..64 {
+        inner_pad[index] = token[index] ^ 0x36;
+        outer_pad[index] = token[index] ^ 0x5c;
+    }
+    let mut hash = Sha256::new();
+    hash.update(inner_pad);
+    hash.update(challenge);
+    hash.update([domain]);
+    let inner = hash.finalize();
+    let mut hash = Sha256::new();
+    hash.update(outer_pad);
+    hash.update(inner);
+    hash.finalize().into()
+}
+
+fn secure_equal(left: &[u8], right: &[u8]) -> bool {
+    left.len() == right.len()
+        && left
+            .iter()
+            .zip(right)
+            .fold(0u8, |difference, (left, right)| difference | (left ^ right))
+            == 0
+}
+
+fn connect(token: &str) -> anyhow::Result<TcpStream> {
+    checked_token(token)?;
+    let mut stream =
+        TcpStream::connect(("127.0.0.1", PORT)).context("native add-on worker is unavailable")?;
+    stream.set_read_timeout(Some(Duration::from_secs(300)))?;
+    stream.set_write_timeout(Some(Duration::from_secs(30)))?;
+    stream.set_nodelay(true)?;
+    authenticate(&mut stream, token)?;
+    Ok(stream)
+}
+
+fn authenticate(stream: &mut TcpStream, token: &str) -> anyhow::Result<()> {
+    let token = checked_token(token)?;
+    let mut hello = [0; HELLO_BYTES];
+    put_u32(&mut hello, MAGIC);
+    put_u32(&mut hello[4..], VERSION);
+    stream.write_all(&hello)?;
+    let mut challenge_reply = [0; CHALLENGE_REPLY_BYTES];
+    stream.read_exact(&mut challenge_reply)?;
+    if get_u32(&challenge_reply) != MAGIC || get_u32(&challenge_reply[4..]) != VERSION {
+        anyhow::bail!("native add-on worker challenge is invalid");
+    }
+    let challenge: [u8; 32] = challenge_reply[8..].try_into().unwrap();
+    let client_proof = authentication_tag(&token, &challenge, b'C');
+    stream.write_all(&client_proof)?;
+    let mut reply = [0; AUTH_REPLY_BYTES];
+    stream.read_exact(&mut reply)?;
+    let expected_server = authentication_tag(&token, &challenge, b'S');
+    if get_u32(&reply) != MAGIC
+        || get_u32(&reply[4..]) != VERSION
+        || !secure_equal(&reply[12..], &expected_server)
+        || get_i32(&reply[8..]) != 0
+    {
+        anyhow::bail!("native add-on worker authentication failed");
+    }
+    Ok(())
+}
+
+fn send_request(
+    stream: &mut TcpStream,
+    command: u32,
+    operation: &str,
+    limit: u64,
+    expected_size: u64,
+    digest: &[u8; 32],
+) -> anyhow::Result<()> {
+    if !operation.is_empty()
+        && (operation.len() != OPERATION_BYTES
+            || !operation.bytes().all(|byte| byte.is_ascii_hexdigit()))
+    {
+        anyhow::bail!("native add-on operation id is invalid");
+    }
+    let mut request = [0; REQUEST_BYTES];
+    put_u32(&mut request, MAGIC);
+    put_u32(&mut request[4..], command);
+    request[8..8 + operation.len()].copy_from_slice(operation.as_bytes());
+    put_u64(&mut request[40..], limit);
+    put_u64(&mut request[48..], expected_size);
+    request[56..88].copy_from_slice(digest);
+    stream.write_all(&request)?;
+    Ok(())
+}
+
+struct WorkerReply {
+    phase: u32,
+    result: i32,
+    done: u64,
+    total: u64,
+    files: u64,
+    write_ms: u64,
+    sync_ms: u64,
+    total_ms: u64,
+    digest: [u8; 32],
+    path: String,
+}
+
+fn read_reply(stream: &mut TcpStream) -> anyhow::Result<WorkerReply> {
+    let mut bytes = [0; REPLY_BYTES];
+    stream.read_exact(&mut bytes)?;
+    if get_u32(&bytes) != MAGIC || get_u32(&bytes[4..]) != VERSION {
+        anyhow::bail!("native add-on worker response is invalid");
+    }
+    let path_length = usize::try_from(get_u32(&bytes[96..])).unwrap_or(usize::MAX);
+    if path_length > 4096 {
+        anyhow::bail!("native add-on worker path is too long");
+    }
+    let mut path = vec![0; path_length];
+    stream.read_exact(&mut path)?;
+    let mut digest = [0; 32];
+    digest.copy_from_slice(&bytes[64..96]);
+    Ok(WorkerReply {
+        phase: get_u32(&bytes[8..]),
+        result: get_i32(&bytes[12..]),
+        done: get_u64(&bytes[16..]),
+        total: get_u64(&bytes[24..]),
+        files: get_u64(&bytes[32..]),
+        write_ms: get_u64(&bytes[40..]),
+        sync_ms: get_u64(&bytes[48..]),
+        total_ms: get_u64(&bytes[56..]),
+        digest,
+        path: String::from_utf8(path).context("native add-on worker path is not UTF-8")?,
+    })
+}
+
+fn checked_worker_path(path: String, operation: &str, leaf: &str) -> anyhow::Result<PathBuf> {
+    let expected = format!("{WINDOWS_ROOT}\\{operation}\\{leaf}");
+    if path != expected {
+        anyhow::bail!("native add-on worker returned an unexpected path");
+    }
+    Ok(PathBuf::from(path))
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct NativeTiming {
+    pub download_ms: u128,
+    pub extract_ms: u64,
+    pub write_ms: u64,
+    pub sync_ms: u64,
+    pub files: u64,
+    pub bytes: u64,
+    pub activate_ms: u64,
+}
+
+pub struct StoredArchive {
+    token: String,
+    operation: String,
+    size: u64,
+    digest: [u8; 32],
+    pub timing: NativeTiming,
+}
+
+impl StoredArchive {
+    fn clean(&self) -> anyhow::Result<()> {
+        let mut stream = connect(&self.token)?;
+        send_request(&mut stream, COMMAND_CLEAN, &self.operation, 0, 0, &[0; 32])?;
+        let reply = read_reply(&mut stream)?;
+        if reply.phase != PHASE_COMPLETE || reply.result != 0 {
+            anyhow::bail!("native add-on worker could not clean staging");
+        }
+        Ok(())
+    }
+}
+
+impl Drop for StoredArchive {
+    fn drop(&mut self) {
+        let _ = self.clean();
+    }
+}
+
+pub async fn download(
+    token: String,
+    client: &reqwest::Client,
+    url: &str,
+    progress: Arc<Mutex<String>>,
+) -> anyhow::Result<StoredArchive> {
+    let operation = operation_id(&token);
+    let mut stream = connect(&token)?;
+    send_request(
+        &mut stream,
+        COMMAND_STORE,
+        &operation,
+        MAX_ARCHIVE_BYTES,
+        0,
+        &[0; 32],
+    )?;
+    let ready = read_reply(&mut stream)?;
+    if ready.phase != PHASE_READY || ready.result != 0 {
+        anyhow::bail!("native add-on worker refused archive staging");
+    }
+    let started = Instant::now();
+    let response = client
+        .get(url)
+        .send()
+        .await
+        .with_context(|| format!("download failed: {url}"))?
+        .error_for_status()
+        .with_context(|| format!("download refused: {url}"))?;
+    let expected_length = response.content_length();
+    if expected_length.is_some_and(|length| length > MAX_ARCHIVE_BYTES) {
+        anyhow::bail!("download exceeded 4 GiB; refusing");
+    }
+    let mut body = response.bytes_stream();
+    let mut total = 0u64;
+    let mut hash = Sha256::new();
+    while let Some(chunk) = body.next().await {
+        let chunk = chunk?;
+        total = total
+            .checked_add(chunk.len() as u64)
+            .filter(|value| *value <= MAX_ARCHIVE_BYTES)
+            .ok_or_else(|| anyhow!("download exceeded 4 GiB; refusing"))?;
+        for piece in chunk.chunks(1024 * 1024) {
+            let length = u32::try_from(piece.len()).context("download chunk is too large")?;
+            stream.write_all(&length.to_le_bytes())?;
+            stream.write_all(piece)?;
+        }
+        hash.update(&chunk);
+        let message = if let Some(length) = expected_length.filter(|length| *length > 0) {
+            format!(
+                "Downloading add-on... {}%",
+                total.saturating_mul(100) / length
+            )
+        } else {
+            format!("Downloading add-on... {} MiB", total / (1024 * 1024))
+        };
+        if let Ok(mut current) = progress.lock() {
+            *current = message;
+        }
+    }
+    if expected_length.is_some_and(|length| length != total) {
+        anyhow::bail!("download ended before its declared size");
+    }
+    let digest: [u8; 32] = hash.finalize().into();
+    stream.write_all(&0u32.to_le_bytes())?;
+    stream.write_all(&total.to_le_bytes())?;
+    stream.write_all(&digest)?;
+    stream.flush()?;
+    let complete = read_reply(&mut stream)?;
+    if complete.phase != PHASE_COMPLETE
+        || complete.result != 0
+        || complete.done != total
+        || complete.total != total
+        || complete.digest != digest
+    {
+        anyhow::bail!("native add-on worker did not accept the downloaded archive");
+    }
+    checked_worker_path(complete.path, &operation, "archive.zip")?;
+    Ok(StoredArchive {
+        token,
+        operation,
+        size: total,
+        digest,
+        timing: NativeTiming {
+            download_ms: started.elapsed().as_millis(),
+            bytes: total,
+            ..Default::default()
+        },
+    })
+}
+
+pub async fn extract(
+    archive: &mut StoredArchive,
+    progress: Arc<Mutex<String>>,
+) -> anyhow::Result<PathBuf> {
+    let token = archive.token.clone();
+    let operation = archive.operation.clone();
+    let size = archive.size;
+    let digest = archive.digest;
+    let result = tokio::task::spawn_blocking(move || -> anyhow::Result<(PathBuf, NativeTiming)> {
+        let mut stream = connect(&token)?;
+        send_request(&mut stream, COMMAND_EXTRACT, &operation, 0, size, &digest)?;
+        let ready = read_reply(&mut stream)?;
+        if ready.phase != PHASE_READY || ready.result != 0 {
+            anyhow::bail!("native add-on worker refused extraction");
+        }
+        loop {
+            let reply = read_reply(&mut stream)?;
+            if reply.phase == PHASE_PROGRESS {
+                if let Ok(mut current) = progress.lock() {
+                    *current = format!("Unpacking add-on... {}/{} files", reply.done, reply.total);
+                }
+                continue;
+            }
+            if reply.phase != PHASE_COMPLETE || reply.result != 0 || reply.done != reply.total {
+                anyhow::bail!("native add-on worker extraction failed");
+            }
+            let path = checked_worker_path(reply.path, &operation, "x")?;
+            return Ok((
+                path,
+                NativeTiming {
+                    extract_ms: reply.total_ms,
+                    write_ms: reply.write_ms,
+                    sync_ms: reply.sync_ms,
+                    files: reply.files,
+                    bytes: size,
+                    ..Default::default()
+                },
+            ));
+        }
+    })
+    .await
+    .map_err(|error| anyhow!(error))??;
+    archive.timing.extract_ms = result.1.extract_ms;
+    archive.timing.write_ms = result.1.write_ms;
+    archive.timing.sync_ms = result.1.sync_ms;
+    archive.timing.files = result.1.files;
+    Ok(result.0)
+}
+
+fn channel_from_addons(addons_dir: &std::path::Path) -> anyhow::Result<String> {
+    // Parse Windows paths explicitly so host tests exercise the same boundary.
+    // Do not canonicalize another drive/root into the helper's fixed destination.
+    let path = addons_dir.to_str().ok_or_else(|| anyhow!("invalid WoW path"))?;
+    let normalized = path.replace('\\', "/");
+    let parts: Vec<_> = normalized.split('/').collect();
+    if parts.len() != 6
+        || !parts[0].eq_ignore_ascii_case("C:")
+        || !parts[1].eq_ignore_ascii_case("Program Files (x86)")
+        || !parts[2].eq_ignore_ascii_case("World of Warcraft")
+        || !parts[4].eq_ignore_ascii_case("Interface")
+        || !parts[5].eq_ignore_ascii_case("AddOns")
+    {
+        anyhow::bail!("native activation requires C:\\Program Files (x86)\\World of Warcraft");
+    }
+    let channel = parts[3];
+    if channel.len() < 3 || channel.len() > 64
+        || !channel.starts_with('_') || !channel.ends_with('_')
+        || !channel.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+    {
+        anyhow::bail!("selected WoW channel name is invalid");
+    }
+    Ok(channel.to_string())
+}
+
+pub async fn activate(
+    archive: &mut StoredArchive,
+    addons_dir: PathBuf,
+    sources: Vec<(String, String)>,
+) -> anyhow::Result<u64> {
+    let channel = channel_from_addons(&addons_dir)?;
+    let product_dir = addons_dir.parent().and_then(|path| path.parent())
+        .ok_or_else(|| anyhow!("selected WoW install is invalid"))?;
+    if crate::wow::describe_install(product_dir).is_none() {
+        anyhow::bail!("native activation requires a supported installed WoW client");
+    }
+    activate_channel(archive, channel, sources).await
+}
+
+async fn activate_channel(
+    archive: &mut StoredArchive,
+    channel: String,
+    sources: Vec<(String, String)>,
+) -> anyhow::Result<u64> {
+    let token = archive.token.clone();
+    let operation = archive.operation.clone();
+    if sources.is_empty() || sources.len() > 2048 {
+        anyhow::bail!("native add-on activation folder count is invalid");
+    }
+    for (source, name) in &sources {
+        if source.is_empty() || source.len() > 1024 || name.is_empty() || name.len() > 255 {
+            anyhow::bail!("native add-on activation path is invalid");
+        }
+    }
+    let move_ms = tokio::task::spawn_blocking(move || -> anyhow::Result<u64> {
+        let mut stream = connect(&token)?;
+        send_request(
+            &mut stream,
+            COMMAND_ACTIVATE,
+            &operation,
+            0,
+            0,
+            &[0; 32],
+        )?;
+        let channel_length =
+            u32::try_from(channel.len()).context("WoW channel name is too long")?;
+        let count = u32::try_from(sources.len()).context("too many add-on folders")?;
+        stream.write_all(&channel_length.to_le_bytes())?;
+        stream.write_all(&count.to_le_bytes())?;
+        stream.write_all(channel.as_bytes())?;
+        for (source, name) in &sources {
+            stream.write_all(&(source.len() as u32).to_le_bytes())?;
+            stream.write_all(&(name.len() as u32).to_le_bytes())?;
+            stream.write_all(source.as_bytes())?;
+            stream.write_all(name.as_bytes())?;
+        }
+        stream.flush()?;
+        let reply = read_reply(&mut stream)?;
+        if reply.phase != PHASE_COMPLETE
+            || reply.result != 0
+            || reply.files != sources.len() as u64
+        {
+            anyhow::bail!("native add-on worker activation failed");
+        }
+        Ok(reply.write_ms)
+    })
+    .await
+    .map_err(|error| anyhow!(error))??;
+    archive.timing.activate_ms = move_ms;
+    Ok(move_ms)
+}
+
+#[cfg(test)]
+mod tests {
