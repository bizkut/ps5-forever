+/// Validate a native worker's durable, immutable extraction before asking the
+/// worker to activate it. No live AddOns path is mutated in this process.
+#[derive(Debug)]
+pub struct NativePlacementPlan {
+    pub sources: Vec<(String, String)>,
+    pub result: PlaceResult,
+}
+
+fn validate_native_tree(root: &Path, depth: usize, entries: &mut usize) -> anyhow::Result<()> {
+    if depth > 32 {
+        anyhow::bail!("native extraction nests folders absurdly deep");
+    }
+    let mut names = std::collections::HashSet::new();
+    for entry in fs::read_dir(root)? {
+        let entry = entry?;
+        *entries += 1;
+        if *entries > 32768 {
+            anyhow::bail!("native extraction contains too many entries");
+        }
+        let name = entry.file_name();
+        let name = name.to_str().ok_or_else(|| anyhow!("non-UTF-8 native filename"))?;
+        let stem = name.split('.').next().unwrap_or("").to_ascii_uppercase();
+        let reserved = matches!(stem.as_str(), "CON" | "PRN" | "AUX" | "NUL")
+            || (stem.len() == 4
+                && (stem.starts_with("COM") || stem.starts_with("LPT"))
+                && matches!(stem.as_bytes()[3], b'1'..=b'9'));
+        if name.is_empty() || name.len() > 255 || !name.is_ascii() || name.starts_with('.')
+            || name.contains("..") || name.ends_with(['.', ' '])
+            || name.chars().any(|c| c.is_control() || "<>:\"/\\|?*".contains(c))
+            || reserved
+        {
+            anyhow::bail!("refusing suspicious folder name or filename {name}");
+        }
+        // The worker accepts ASCII names only, avoiding Unicode case ambiguity.
+        if !names.insert(name.to_ascii_lowercase()) {
+            anyhow::bail!("native extraction contains a Windows namespace collision");
+        }
+        let kind = entry.file_type()?;
+        if kind.is_symlink() || (!kind.is_dir() && !kind.is_file()) {
+            anyhow::bail!("native extraction contains a non-regular entry");
+        }
+        if kind.is_dir() {
+            validate_native_tree(&entry.path(), depth + 1, entries)?;
+        }
+    }
+    Ok(())
+}
+
+pub fn validate_native_extracted(
+    extract_dir: &Path,
+    flavor: crate::flavor::Flavor,
+    extract_ms: u64,
+) -> anyhow::Result<NativePlacementPlan> {
+    validate_native_tree(extract_dir, 0, &mut 0)?;
+    let files = safety_scan(extract_dir)?;
+    crate::logi!("native zip ok: {} files, no executables", files);
+    let sources = addon_dirs(extract_dir)?;
+    if sources.is_empty() || sources.len() > 2048 {
+        anyhow::bail!("native activation has too many add-on folders");
+    }
+    for source in &sources {
+        if !crate::wow::addon_supports(source, flavor) {
+            anyhow::bail!(
+                "Add-on TOCs do not support the selected {} client",
+                flavor.id()
+            );
+        }
+    }
+    let mut mappings = Vec::with_capacity(sources.len());
+    for source in sources {
+        let name = source
+            .file_name()
+            .and_then(|name| name.to_str())
+            .ok_or_else(|| anyhow!("bad folder name"))?
+            .to_string();
+        if name.is_empty()
+            || name.starts_with('.')
+            || name.contains("..")
+            || name.contains(['/', '\\'])
+        {
+            anyhow::bail!("refusing suspicious folder name {name}");
+        }
+        let relative = source
+            .strip_prefix(extract_dir)
+            .map_err(|_| anyhow!("native worker returned a folder outside staging"))?;
+        let mut source_wire = String::new();
+        for component in relative.components() {
+            let std::path::Component::Normal(component) = component else {
+                anyhow::bail!("native worker returned an unsafe staged folder");
+            };
+            let component = component
+                .to_str()
+                .ok_or_else(|| anyhow!("native worker returned a non-UTF-8 folder"))?;
+            if !source_wire.is_empty() {
+                source_wire.push('/');
+            }
+            source_wire.push_str(component);
+        }
+        if source_wire.len() > 1024 {
+            anyhow::bail!("native staged folder path is too long");
+        }
+        mappings.push((source_wire, name));
+    }
+    let folders = mappings.iter().map(|(_, name)| name.clone()).collect();
+    Ok(NativePlacementPlan {
+        sources: mappings,
+        result: PlaceResult {
+            folders,
+            zip_ms: extract_ms as u128,
+            broker_move_ms: 0,
+        },
+    })
+}
