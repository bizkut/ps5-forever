+    #[test]
+    fn refuses_to_redirect_another_install_into_the_fixed_root() {
+        let accepted = PathBuf::from(r"C:\Program Files (x86)\World of Warcraft\_forever_\Interface\AddOns");
+        assert_eq!(channel_from_addons(&accepted).unwrap(), "_forever_");
+        for path in [
+            r"W:\Program Files (x86)\World of Warcraft\_forever_\Interface\AddOns",
+            r"C:\Games\World of Warcraft\_forever_\Interface\AddOns",
+            r"C:\Program Files (x86)\World of Warcraft\..\Interface\AddOns",
+            r"C:\Program Files (x86)\World of Warcraft\_forever_\Interface\AddOns\",
+        ] {
+            assert!(channel_from_addons(&PathBuf::from(path)).is_err());
+        }
+    }
+
+    #[test]
+    fn authenticates_server_and_rejects_replayed_or_reflected_proofs() {
+        for mode in 0..4 {
+            let token = "a".repeat(64);
+            let server_token = token.clone();
+            let listener = std::net::TcpListener::bind(("127.0.0.1", 0)).unwrap();
+            let address = listener.local_addr().unwrap();
+            let server = std::thread::spawn(move || {
+                let (mut socket, _) = listener.accept().unwrap();
+                let mut hello = [0; HELLO_BYTES];
+                socket.read_exact(&mut hello).unwrap();
+                let challenge = [7u8; 32];
+                let mut reply = [0; CHALLENGE_REPLY_BYTES];
+                put_u32(&mut reply, MAGIC);
+                put_u32(&mut reply[4..], VERSION);
+                reply[8..].copy_from_slice(&challenge);
+                socket.write_all(&reply).unwrap();
+                let mut proof = [0; 32];
+                socket.read_exact(&mut proof).unwrap();
+                let key = checked_token(&server_token).unwrap();
+                assert_eq!(proof, authentication_tag(&key, &challenge, b'C'));
+                let tag = match mode {
+                    0 => authentication_tag(&key, &challenge, b'S'),
+                    1 => proof,
+                    2 => authentication_tag(&key, &[6; 32], b'S'),
+                    _ => [0; 32],
+                };
+                let mut auth = [0; AUTH_REPLY_BYTES];
+                put_u32(&mut auth, MAGIC);
+                put_u32(&mut auth[4..], VERSION);
+                auth[12..].copy_from_slice(&tag);
+                socket.write_all(&auth).unwrap();
+            });
+            let mut socket = TcpStream::connect(address).unwrap();
+            socket.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+            assert_eq!(authenticate(&mut socket, &token).is_ok(), mode == 0);
+            server.join().unwrap();
+        }
+    }
+
