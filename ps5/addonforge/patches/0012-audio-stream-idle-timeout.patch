+        archive.write_all(b"## Interface: 16001\n## Title: Spoken Audio: Quests - Shared\n## Version: 2.4.0\n").unwrap();
+        archive.start_file("SpokenQuestsAudioShared/audio.ogg", options).unwrap();
+        archive.write_all(b"OggS minimized audio payload").unwrap();
+        archive.finish().unwrap().into_inner()
+    }
