+fn open_trash_directory(path: &Path) -> std::io::Result<fs::File> {
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::OpenOptionsExt;
+        // FlushFileBuffers requires write access; opening a directory also needs
+        // backup semantics. Do not follow a final-component reparse point.
+        const GENERIC_READ_WRITE: u32 = 0xc000_0000;
+        const FILE_SHARE_ALL: u32 = 0x7;
+        const FILE_FLAG_BACKUP_SEMANTICS: u32 = 0x0200_0000;
+        const FILE_FLAG_OPEN_REPARSE_POINT: u32 = 0x0020_0000;
+        fs::OpenOptions::new()
+            .access_mode(GENERIC_READ_WRITE)
+            .share_mode(FILE_SHARE_ALL)
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT)
+            .open(path)
+    }
+    #[cfg(not(windows))]
+    fs::File::open(path)
+}
