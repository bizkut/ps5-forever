+/* Build the 512x128 64KB_R_X macro-tile map from RADV's AddrLib once. This
+ * avoids hundreds of thousands of AddrLib calls in the pre-flip readback. */
+static uint16_t *videoout_capture_tilemap;
+static bool videoout_capture_tilemap_attempted;
+
+static uint64_t
+videoout_capture_tiled_offset(const struct wsi_device *wsi, VkImage image,
+                              uint32_t x, uint32_t y)
+{
+   if (!videoout_capture_tilemap)
+      return wsi->videoout_image_offset(image, x, y);
+   const uint64_t word =
+      (uint64_t)(y >> 7) * 128 * VIDEOOUT_WIDTH +
+      (uint64_t)(x >> 9) * (512 * 128) +
+      videoout_capture_tilemap[(y & 127) * 512 + (x & 511)];
+   return word * sizeof(uint32_t);
+}
+
+static void
+videoout_capture_prepare_tilemap(const struct wsi_device *wsi, VkImage image)
+{
+   if (videoout_capture_tilemap_attempted || !wsi->videoout_image_offset)
+      return;
+   videoout_capture_tilemap_attempted = true;
+   uint16_t *tilemap = malloc(512 * 128 * sizeof(*tilemap));
+   if (!tilemap)
+      return;
+   for (uint32_t y = 0; y < 128; y++) {
+      for (uint32_t x = 0; x < 512; x++) {
+         const uint64_t offset = wsi->videoout_image_offset(image, x, y);
+         if ((offset & 3) || offset / 4 > UINT16_MAX) {
+            free(tilemap);
+            return;
+         }
+         tilemap[y * 512 + x] = (uint16_t)(offset / 4);
+      }
+   }
+   videoout_capture_tilemap = tilemap;
+   static const uint16_t check[4][2] = {
+      {480, 270}, {1440, 270}, {480, 1080}, {3360, 1080},
+   };
+   for (uint32_t i = 0; i < ARRAY_SIZE(check); i++) {
+      if (videoout_capture_tiled_offset(wsi, image, check[i][0], check[i][1]) !=
+          wsi->videoout_image_offset(image, check[i][0], check[i][1])) {
+         free(videoout_capture_tilemap);
+         videoout_capture_tilemap = NULL;
+         fprintf(stderr, "wsi/videoout: capture tiled LUT rejected; using AddrLib per pixel\n");
+         return;
+      }
+   }
+}
