+static void
+videoout_capture_presented(struct wsi_videoout_output *out,
+                           struct wsi_videoout_swapchain *chain,
+                           const struct wsi_videoout_present *present)
+{
+   static uint64_t check_ns, sequence;
+   static unsigned pending_scale;
+   const uint64_t now = os_time_get_nano();
+
+   mtx_lock(&out->lock);
+   const bool busy = out->capture_writing || out->capture_job != NULL;
+   mtx_unlock(&out->lock);
+   if (!pending_scale) {
+      if (now - check_ns < UINT64_C(1000000000) || busy)
+         return;
+      check_ns = now;
+      pending_scale = videoout_capture_read_request();
+      if (pending_scale && chain->base.wsi->videoout_image_offset)
+         videoout_capture_prepare_tilemap(chain->base.wsi, chain->images[0].image);
+      return; /* The next presented frame is the one captured. */
+   }
+   if (busy)
+      return;
+   if (!chain->base.wsi->videoout_image_offset) {
+      fprintf(stderr, "wsi/videoout: capture unavailable: no tiled-address callback\n");
+      pending_scale = 0;
+      return;
+   }
+
+   const unsigned scale = pending_scale;
+   pending_scale = 0;
+   const uint32_t width = VIDEOOUT_WIDTH / scale;
+   const uint32_t height = VIDEOOUT_HEIGHT / scale;
+   const size_t payload_bytes = (size_t)width * height * sizeof(uint32_t);
+   struct videoout_capture_job *job = malloc(sizeof(*job) + payload_bytes);
+   if (!job) {
+      fprintf(stderr, "wsi/videoout: capture allocation failed bytes=%zu\n", payload_bytes);
+      return;
+   }
+   memset(job, 0, sizeof(*job));
+   memcpy(job->header.magic, "PS5CAP1", 7);
+   job->header.width = width;
+   job->header.height = height;
+   job->header.source_width = VIDEOOUT_WIDTH;
+   job->header.source_height = VIDEOOUT_HEIGHT;
+   job->header.format = chain->format;
+   job->header.color_space = chain->color_space;
+   job->header.pixel_format = out->set[chain->set].pixel_format;
+   job->header.sequence = ++sequence;
+   job->header.timestamp_ns = now;
+   job->payload_bytes = payload_bytes;
+   if (snprintf(job->path, sizeof(job->path), VIDEOOUT_CAPTURE_PREFIX "%" PRIu64 ".bin",
+                sequence) >= (int)sizeof(job->path) ||
+       snprintf(job->temporary, sizeof(job->temporary), VIDEOOUT_CAPTURE_PREFIX
+                "%" PRIu64 ".tmp", sequence) >= (int)sizeof(job->temporary)) {
+      free(job);
+      return;
+   }
+
+   const uint32_t index = present->buffer - chain->first;
+   const uint8_t *source = out->set[chain->set].memory +
+                           (uint64_t)index * VIDEOOUT_BUFFER_BYTES;
+   for (size_t at = 0; at < VIDEOOUT_BUFFER_BYTES; at += 64)
+      _mm_clflush(source + at);
+   _mm_mfence();
+
+   uint32_t *pixels = (uint32_t *)job->pixels;
+   for (uint32_t y = 0; y < height; y++) {
+      for (uint32_t x = 0; x < width; x++) {
+         const uint64_t offset = videoout_capture_tiled_offset(
+            chain->base.wsi, chain->images[index].image, x * scale, y * scale);
+         if (offset + sizeof(uint32_t) > VIDEOOUT_BUFFER_BYTES) {
+            fprintf(stderr, "wsi/videoout: capture tiled address out of range x=%u y=%u"
+                            " offset=0x%" PRIx64 "\n",
+                    x * scale, y * scale, offset);
+            free(job);
+            return;
+         }
+         memcpy(&pixels[(size_t)y * width + x], source + offset, sizeof(uint32_t));
+      }
+   }
+
+   mtx_lock(&out->lock);
+   bool queued = !out->capture_writing && out->capture_job == NULL;
+   if (queued && !out->capture_thread_started) {
+      queued = thrd_create(&out->capture_thread, videoout_capture_writer, out) == thrd_success;
+      out->capture_thread_started = queued;
+   }
+   if (queued) {
+      out->capture_job = job;
+      cnd_broadcast(&out->changed);
+   }
+   mtx_unlock(&out->lock);
+   if (!queued) {
+      fprintf(stderr, "wsi/videoout: capture skipped: writer busy\n");
+      free(job);
+   }
+}
