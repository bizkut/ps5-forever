+   for (uint32_t at = 0; at + sizeof(uint32_t) <= stage->spirv.size; at += sizeof(uint32_t)) {
+      uint32_t word;
+      memcpy(&word, stage->spirv.data + at, sizeof(word));
+      if (word == UINT32_C(0x429db000)) {
+         target = true;
+         break;
+      }
