+#if defined(__PROSPERO__)
+static void
+radv_ps5_write_shader_section(FILE *file, const char *name, const char *text,
+                              size_t *remaining)
+{
+   fprintf(file, "\n=== %s ===\n", name);
+   if (!text) {
+      fprintf(file, "(unavailable)\n");
+      return;
+   }
+   const size_t length = strlen(text);
+   const size_t written = MIN2(length, *remaining);
+   fwrite(text, 1, written, file);
+   *remaining -= written;
+   if (written != length)
+      fprintf(file, "\n[truncated at diagnostic bound]\n");
+}
