+bool
+radv_ps5_dump_shader_artifacts(const struct radv_compiler_info *compiler_info,
+                               const struct radv_shader_binary *binary,
+                               struct nir_shader *const *shaders, int shader_count,
+                               unsigned sequence)
+{
+   if (!binary || shader_count <= 0)
+      return false;
+   char text_path[96], binary_path[96];
+   if (snprintf(text_path, sizeof(text_path), "/app0/wine/radv-shader-%u.txt", sequence) >=
+          (int)sizeof(text_path) ||
+       snprintf(binary_path, sizeof(binary_path), "/app0/wine/radv-shader-%u.bin", sequence) >=
+          (int)sizeof(binary_path))
+      return false;
+
+   char *nir_string = radv_dump_nir_shaders(compiler_info, shaders, shader_count);
+   struct radv_shader_debug_info debug = {0};
+   radv_parse_binary_debug_info(compiler_info, binary, &debug);
+
+   unsigned fp_math_ctrl = 0;
+   nir_shader *shader = shaders[shader_count - 1];
+   nir_foreach_function_impl (impl, shader) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type == nir_instr_type_alu)
+               fp_math_ctrl |= nir_instr_as_alu(instr)->fp_math_ctrl;
+         }
+      }
+   }
+
+   FILE *file = fopen(text_path, "wb");
+   bool written = false;
+   if (file) {
+      const unsigned execution_mode = shader->info.float_controls_execution_mode;
+      fprintf(file, "PS5 RADV fragment shader diagnostic %u\n", sequence);
+      fprintf(file, "float_controls_execution_mode=0x%x\n", execution_mode);
+      fprintf(file, "denorm_flush_to_zero_fp32=%u\n",
+              !!(execution_mode & FLOAT_CONTROLS_DENORM_FLUSH_TO_ZERO_FP32));
+      fprintf(file, "nir_fp_math_ctrl_or=0x%x preserve_signed_zero=%u preserve_inf=%u"
+                    " preserve_nan=%u exact=%u\n",
+              fp_math_ctrl, !!(fp_math_ctrl & nir_fp_preserve_signed_zero),
+              !!(fp_math_ctrl & nir_fp_preserve_inf), !!(fp_math_ctrl & nir_fp_preserve_nan),
+              !!(fp_math_ctrl & nir_fp_exact));
+      fprintf(file, "stage=%u wave_size=%u ps_has_epilog=%u num_sgprs=%u num_vgprs=%u\n",
+              shader->info.stage, binary->info.wave_size, binary->info.ps.has_epilog,
+              binary->config.num_sgprs, binary->config.num_vgprs);
+      fprintf(file, "binary_float_mode=0x%x lower_fpow=%u has_fmulz_no_denorms=%u\n",
+              binary->config.float_mode, shader->options->lower_fpow,
+              shader->options->has_fmulz_no_denorms);
+      size_t remaining = 4 * 1024 * 1024;
+      radv_ps5_write_shader_section(file, "final NIR", nir_string, &remaining);
+      radv_ps5_write_shader_section(file, "ACO IR", debug.ir_string, &remaining);
+      radv_ps5_write_shader_section(file, "ACO disassembly", debug.disasm_string, &remaining);
+      written = fclose(file) == 0;
+   }
+
+   if (binary->type == RADV_BINARY_TYPE_LEGACY) {
+      struct radv_shader_binary_legacy *legacy = (struct radv_shader_binary_legacy *)binary;
+      const struct radv_shader_binary_layout layout = radv_shader_binary_get_layout(legacy);
+      FILE *raw = fopen(binary_path, "wb");
+      if (raw) {
+         const bool code_written = fwrite(layout.code, 1, legacy->exec_size, raw) == legacy->exec_size;
+         const int close_result = fclose(raw);
+         if (!code_written || close_result != 0)
+            remove(binary_path);
+      }
+   }
+
+   free(nir_string);
+   free(debug.disasm_string);
+   free(debug.ir_string);
+   free(debug.statistics);
+   free(debug.debug_info);
+   if (written)
+      fprintf(stderr, "[radv] shader dump n=%u path=%s\n", sequence, text_path);
+   return written;
+}
