+#if defined(__PROSPERO__)
+static int
+videoout_capture_writer(void *data)
+{
+   struct wsi_videoout_output *out = data;
+   for (;;) {
+      mtx_lock(&out->lock);
+      while (!out->capture_job)
+         cnd_wait(&out->changed, &out->lock);
+      struct videoout_capture_job *job = out->capture_job;
+      out->capture_job = NULL;
+      out->capture_writing = true;
+      mtx_unlock(&out->lock);
+
+      bool written = false;
+      FILE *file = fopen(job->temporary, "wb");
+      if (file) {
+         const bool header_ok =
+            fwrite(&job->header, 1, sizeof(job->header), file) == sizeof(job->header);
+         const bool pixels_ok =
+            header_ok && fwrite(job->pixels, 1, job->payload_bytes, file) == job->payload_bytes;
+         const int close_result = fclose(file);
+         written = pixels_ok && close_result == 0 && rename(job->temporary, job->path) == 0;
+      }
+      if (!written)
+         remove(job->temporary);
+
+      const size_t bytes = sizeof(job->header) + job->payload_bytes;
+      if (written)
+         fprintf(stderr, "wsi/videoout: capture seq=%" PRIu64 " file=%s format=%u bytes=%zu\n",
+                 job->header.sequence, job->path, job->header.format, bytes);
+      else
+         fprintf(stderr, "wsi/videoout: capture failed seq=%" PRIu64 " file=%s\n",
+                 job->header.sequence, job->path);
+      free(job);
+
+      mtx_lock(&out->lock);
+      out->capture_writing = false;
+      cnd_broadcast(&out->changed);
+      mtx_unlock(&out->lock);
+   }
+   return 0;
+}
