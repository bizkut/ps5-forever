+static unsigned
+videoout_capture_read_request(void)
+{
+   FILE *file = fopen(VIDEOOUT_CAPTURE_REQUEST, "rb");
+   if (!file)
+      return 0;
+   unsigned scale = 4;
+   char line[64];
+   while (fgets(line, sizeof(line), file)) {
+      char *at = line;
+      while (*at == ' ' || *at == '\t')
+         at++;
+      if (strncmp(at, "scale=", 6) == 0) {
+         const unsigned requested = (unsigned)strtoul(at + 6, NULL, 0);
+         if (requested == 2 || requested == 4 || requested == 8)
+            scale = requested;
+         else
+            fprintf(stderr, "wsi/videoout: capture request invalid scale=%u fallback=4\n",
+                    requested);
+      }
+   }
+   const bool read_ok = !ferror(file);
+   fclose(file);
+   if (!read_ok || remove(VIDEOOUT_CAPTURE_REQUEST) != 0) {
+      fprintf(stderr, "wsi/videoout: capture request could not be consumed\n");
+      return 0;
+   }
+   return scale;
+}
