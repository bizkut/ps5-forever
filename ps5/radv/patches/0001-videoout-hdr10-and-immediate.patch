+static const char *
+videoout_hdr_output_mode_name(enum videoout_hdr_output_mode mode)
+{
+   switch (mode) {
+   case VIDEOOUT_HDR_OUTPUT_EXPLICIT:
+      return "explicit";
+   case VIDEOOUT_HDR_OUTPUT_WILDCARD:
+      return "wildcard";
+   default:
+      return "token-only";
+   }
+}
+
+static int
+videoout_get_output_status_locked(struct videoout_output_status *status)
+{
+   memset(status, 0, sizeof(*status));
+#if defined(__PROSPERO__)
+   return sceVideoOutGetOutputStatus(videoout_output.handle, status);
+#else
+   return 0;
+#endif
+}
+
+static bool
+videoout_color_locked(bool hdr, enum videoout_hdr_output_mode requested)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   if (out->hdr == hdr)
+      return true;
+
+   static const char *const variant_name[] = {
+      "unprobed", "explicit", "wildcard", "token-only",
+   };
+   struct videoout_output_status before, after;
+   const int before_result = videoout_get_output_status_locked(&before);
+   unsigned variant = 3;
+   int result = 0;
+#if defined(__PROSPERO__)
+   if (hdr && requested != VIDEOOUT_HDR_OUTPUT_TOKEN_ONLY) {
+      if (!videoout_diagnostic_mode.changed) {
+         _Alignas(8) uint8_t current[32] = {0};
+         const int current_result = sceVideoOutGetCurrentOutputMode_(out->handle, current);
+         uint32_t current_size = 0;
+         memcpy(&current_size, current, sizeof(current_size));
+         videoout_diagnostic_mode.saved_valid =
+            current_result == 0 && current_size == sizeof(current);
+         if (videoout_diagnostic_mode.saved_valid)
+            memcpy(videoout_diagnostic_mode.saved_mode, current,
+                   sizeof(videoout_diagnostic_mode.saved_mode));
+      }
+
+      const unsigned requested_variant =
+         requested == VIDEOOUT_HDR_OUTPUT_EXPLICIT ? 1 : 2;
+      variant = MAX2(requested_variant, videoout_diagnostic_mode.working_variant);
+      const uint64_t refresh = before_result == 0 && before.refresh_rate != 0
+                                  ? before.refresh_rate
+                                  : out->high_frame_rate ? UINT64_C(13) : UINT64_C(3);
+      for (;;) {
+         if (variant >= 3) {
+            variant = 3;
+            result = 0;
+            break;
+         }
+         _Alignas(8) uint8_t mode[32] = {0};
+         _Alignas(8) uint64_t options[2] = {0};
+         sceVideoOutModeSetAny_(mode, sizeof(mode));
+         if (variant == 1) {
+            mode[4] = 3;  /* YCbCr 4:2:2. */
+            mode[5] = 2;  /* Limited range. */
+            mode[7] = 30; /* 10 bits per component on the HDMI link. */
+            memcpy(mode + 8, &refresh, sizeof(refresh));
+         }
+         mode[6] = 12; /* BT.2020 PQ. */
+         sceVideoOutConfigureOptionsInitialize_(options, sizeof(options));
+         uint64_t words[4];
+         memcpy(words, mode, sizeof(words));
+         videoout_diagnostic_mode.changed = true;
+         result = sceVideoOutConfigureOutputModeEx_(out->handle, 0, mode, options,
+                                                    sizeof(mode), sizeof(options));
+         fprintf(stderr, "wsi/videoout: HDR diagnostic output attempt variant=%s result=0x%08x"
+                         " fields4..7=%02x,%02x,%02x,%02x refresh=0x%016" PRIx64
+                         " resolution=0x%016" PRIx64 " field24=%02x\n",
+                 variant_name[variant], (unsigned)result, mode[4], mode[5], mode[6], mode[7],
+                 words[1], words[2], mode[24]);
+         if (result == 0)
+            break;
+         variant++;
+      }
+      videoout_diagnostic_mode.working_variant = variant;
+   }
+#endif
+   const int after_result = videoout_get_output_status_locked(&after);
+   out->hdr = hdr;
+   fprintf(stderr,
+           "wsi/videoout: %s output mode=%s requested=%s status_before=0x%08x"
+           " dynamic_range=%u refresh=0x%016" PRIx64 " flags=0x%016" PRIx64
+           " status_after=0x%08x dynamic_range=%u refresh=0x%016" PRIx64
+           " flags=0x%016" PRIx64 "\n",
+           hdr ? "HDR" : "SDR",
+           hdr ? variant_name[variant] : "token-only",
+           videoout_hdr_output_mode_name(requested),
+           (unsigned)before_result, before.dynamic_range, before.refresh_rate, before.flags,
+           (unsigned)after_result, after.dynamic_range, after.refresh_rate, after.flags);
+   return result == 0;
+}
+
+static void
+videoout_restore_diagnostic_mode_locked(void)
+{
+   if (!videoout_diagnostic_mode.changed)
+      return;
+   int result = 0;
+#if defined(__PROSPERO__)
+   int exact = -1;
+   if (videoout_diagnostic_mode.saved_valid) {
+      _Alignas(8) uint64_t options[2] = {0};
+      sceVideoOutConfigureOptionsInitialize_(options, sizeof(options));
+      exact = sceVideoOutConfigureOutputModeEx_(
+         videoout_output.handle, 0, videoout_diagnostic_mode.saved_mode, options,
+         sizeof(videoout_diagnostic_mode.saved_mode), sizeof(options));
+   }
+   result = exact == 0 ? 0 : sceVideoOutConfigureOutput(
+      videoout_output.handle,
+      videoout_output.high_frame_rate ? PS5_VIDEO_OUT_MODE_HIGH_FRAME_RATE
+                                      : PS5_VIDEO_OUT_MODE_RESTORE,
+      NULL, NULL, NULL);
+   fprintf(stderr,
+           "wsi/videoout: diagnostic output restore exact=0x%08x selector=%u result=0x%08x\n",
+           (unsigned)exact,
+           videoout_output.high_frame_rate ? PS5_VIDEO_OUT_MODE_HIGH_FRAME_RATE
+                                           : PS5_VIDEO_OUT_MODE_RESTORE,
+           (unsigned)result);
+#endif
+   videoout_diagnostic_mode.changed = false;
+   videoout_diagnostic_mode.saved_valid = false;
+}
